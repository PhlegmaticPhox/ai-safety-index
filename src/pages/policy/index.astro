---
/**
 * The law and policy index.
 *
 * Hand-written rather than scraped, because the established trackers are
 * protected databases and bulk-extracting one is not a licence we have.
 *
 * Jurisdiction order comes from the dataset and is deliberate: most binding
 * AI-specific law first. Re-sorting alphabetically here would throw away the one
 * comparison the page exists to make.
 */
import Base from "../../layouts/Base.astro";
import Provenance from "../../components/Provenance.astro";
import { assertRenderable, freshness, oldestRetrieved, getSource, type Dataset } from "../../lib/sources";

import indexFile from "../../../data/processed/policy-index.json";
import governanceFile from "../../../data/processed/governance-readiness.json";

interface PolicyRecord {
  jurisdiction: string;
  jurisdiction_slug: string;
  jurisdiction_code: string;
  title: string;
  force: string;
  force_meaning: string;
  year: number;
  body: string;
  topics: string[];
  note: string;
  url: string;
  reviewed: string;
  source_id: string;
}

interface GovernanceRecord {
  code: string;
  name: string;
  readiness: number;
  basis: string;
  source_id: string;
}

const policy = indexFile as Dataset<PolicyRecord>;
const governance = governanceFile as Dataset<GovernanceRecord>;
const cites = [...new Set([...policy.sources, ...governance.sources])];
assertRenderable(...cites);

/* The seven force levels in the dataset, collapsed to five columns. The three
   kinds of binding instrument read as one thing to a reader asking "does this
   bite"; the distinction between them is kept on each jurisdiction's own page. */
const GROUPS = [
  { key: "binding", label: "Binding law", forces: ["statute", "delegated"] },
  { key: "government", label: "Binds government", forces: ["agency-binding"] },
  { key: "guidance", label: "Regulator guidance", forces: ["regulator-guidance"] },
  { key: "voluntary", label: "Voluntary", forces: ["voluntary"] },
  { key: "pending", label: "Proposed or in review", forces: ["proposal", "review"] },
];

/* An instrument that says so in its own title. The number worth having is how
   small this is next to the binding count, so the test is deliberately generous:
   anything naming AI, artificial intelligence, deepfakes or synthetic content
   counts. A narrow test would flatter the point. */
const NAMES_AI = /\bAI\b|Artificial Intelligence|Deepfake|Synthetic Content/i;

/* The EU is scored once at bloc level and that score is stored against each
   member state, so the bloc has no readiness record of its own to look up.
   Reading any harmonised member returns the bloc score by construction. */
const euScore = governance.records.find((g) => g.basis === "eu-harmonised")?.readiness ?? null;

const jurisdictions = [...new Set(policy.records.map((r) => r.jurisdiction_slug))].map((slug) => {
  const rows = policy.records.filter((r) => r.jurisdiction_slug === slug);
  const code = rows[0].jurisdiction_code;
  const scored = governance.records.find((g) => g.code === code && g.basis === "national");
  const counts = Object.fromEntries(
    GROUPS.map((g) => [g.key, rows.filter((r) => g.forces.includes(r.force)).length]),
  ) as Record<string, number>;
  const binding = rows.filter((r) => r.force === "statute" || r.force === "delegated");
  return {
    slug,
    name: rows[0].jurisdiction,
    code,
    count: rows.length,
    counts,
    binding: binding.length,
    namesAI: binding.filter((r) => NAMES_AI.test(r.title)).length,
    readiness: scored?.readiness ?? (code === "EUR" ? euScore : null),
    isBloc: code === "EUR",
  };
});

const totalBinding = jurisdictions.reduce((sum, j) => sum + j.binding, 0);
const totalNaming = jurisdictions.reduce((sum, j) => sum + j.namesAI, 0);

const coveredCodes = new Set(jurisdictions.map((j) => j.code));
const scoredOnly = governance.records
  .filter((g) => !coveredCodes.has(g.code) && g.basis === "national")
  .sort((a, b) => b.readiness - a.readiness);

const retrievedAt = oldestRetrieved(policy, governance);
const checked = freshness(retrievedAt);

/* Dataset markup for the index this page is. Values come from the envelope and
   the source registry. dateModified uses `generated`, which only moves when the
   records change; temporalCoverage is the span of adoption years actually present
   in the records, which reaches back well before AI because most applicable law
   does. The eleven jurisdiction routes are views of this one dataset and carry no
   Dataset node of their own, or one dataset becomes twelve in any index that
   reads it. */
const src = getSource("policy-index");
const SITE_URL = "https://aisafetytracker.org";
const years = policy.records.map((r) => r.year);
const schema = {
  "@type": "Dataset",
  "@id": `${SITE_URL}/policy/#dataset`,
  name: src.name,
  description: policy.notes,
  url: `${SITE_URL}/policy/`,
  license: src.licence_url,
  isAccessibleForFree: true,
  creator: { "@id": `${SITE_URL}/#publisher` },
  publisher: { "@id": `${SITE_URL}/#publisher` },
  dateModified: policy.generated,
  temporalCoverage: `${Math.min(...years)}/${Math.max(...years)}`,
  keywords: ["AI law", "AI regulation", "AI policy", "legal instruments", "jurisdictions"],
  measurementTechnique:
    "Each instrument read in its primary source and tagged by how binding it is, with a link to that source on every record.",
  variableMeasured: [
    {
      "@type": "PropertyValue",
      name: "force",
      description:
        "How binding the instrument is: statute, delegated, agency-binding, regulator-guidance, voluntary, proposal or review.",
    },
    { "@type": "PropertyValue", name: "year", description: "Year the instrument was adopted." },
    {
      "@type": "PropertyValue",
      name: "topics",
      description: "What the instrument regulates, as tagged here.",
    },
  ],
  spatialCoverage: jurisdictions.map((j) => ({ "@type": "Place", name: j.name })),
  distribution: {
    "@type": "DataDownload",
    encodingFormat: "application/json",
    contentUrl:
      "https://raw.githubusercontent.com/PhlegmaticPhox/ai-safety-index/main/data/processed/policy-index.json",
  },
};
---

<Base
  field="policy"
  title="AI law and policy"
  description="An index of the law that actually applies to AI across eleven jurisdictions, tagged by how binding each instrument is, with a link to every primary source."
  cites={cites}
  schema={schema}
>
  <section class="section section--open">
    <div class="wrap">
      <div class="masthead">
        <h1>AI law and policy</h1>
        <p class="masthead__meta mono">
          {jurisdictions.length} jurisdictions
          <span aria-hidden="true">/</span>
          {policy.count} instruments
          <span aria-hidden="true">/</span>
          <time datetime={retrievedAt} class={checked.stale ? "is-stale" : undefined}>reviewed {checked.label}</time>
        </p>
      </div>

      <p class="masthead__lede">
        {totalBinding} of the {policy.count} instruments indexed here are binding law, and
        {" "}{totalNaming} of those name AI in their own title. The remainder apply to AI without
        mentioning it. Every entry is tagged by how binding it is and links to its primary
        source. The same records are also available <a href="/policy/timeline/">by year</a>.
      </p>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head">
        <h2>Indexed jurisdictions</h2>
        <p>
          Ordered by how much binding AI-specific law is in force, most first. The European
          Union is indexed once at bloc level, covering all 27 member states.
        </p>
      </div>

      <ul class="cards">
        {
          jurisdictions.map((jurisdiction) => (
            <li class="card">
              <a href={`/policy/${jurisdiction.slug}/`} class="card__title">
                {jurisdiction.name}
              </a>
              <p>
                {jurisdiction.count} instruments, {jurisdiction.binding} of them binding law,
                {" "}{jurisdiction.namesAI} of those naming AI.
              </p>
              <span class="card__meta mono">
                {jurisdiction.readiness !== null
                  ? `Readiness ${jurisdiction.readiness} of 100${jurisdiction.isBloc ? ", bloc level" : ""}`
                  : "Not yet scored"}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="caveat">
        Not legal advice, not a compliance checklist and not exhaustive. It is a map of where to
        start reading. Statuses and commencement dates go stale, and every record carries the
        date it was reviewed.
      </p>
    </div>
  </section>

  <section class="section" id="compare">
    <div class="wrap">
      <div class="section-head">
        <h2>What each jurisdiction has</h2>
        <p>
          Indexed instruments by how binding each one is.
        </p>
      </div>

      <div class="scroll-x">
        <table class="grid-table">
          <caption class="visually-hidden">
            Count of indexed instruments per jurisdiction, grouped by how binding each is, with
            the governance readiness score.
          </caption>
          <thead>
            <tr>
              <th scope="col">Jurisdiction</th>
              {GROUPS.map((group) => <th scope="col" class="ta-end">{group.label}</th>)}
              <th scope="col" class="ta-end">Total</th>
              <th scope="col" class="ta-end">Readiness</th>
            </tr>
          </thead>
          <tbody>
            {
              jurisdictions.map((row) => (
                <tr>
                  <th scope="row">
                    <a href={`/policy/${row.slug}/`}>{row.name}</a>
                  </th>
                  {GROUPS.map((group) => (
                    <td class:list={["ta-end", "num", !row.counts[group.key] && "muted-cell"]}>
                      {row.counts[group.key]}
                    </td>
                  ))}
                  <td class="ta-end num">{row.count}</td>
                  <td class="ta-end num muted-cell">{row.readiness ?? "-"}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="caveat">
        Counts are of what this index lists, not of what exists. Australia's total is larger
        than the others because it was indexed first and in more depth, which is a fact about
        the index rather than about Australian law. Read the columns against each other within a
        row rather than the totals across rows.
        <Provenance source={policy.sources} retrieved={policy.retrieved} />
      </p>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head">
        <h2>Scored but not yet indexed</h2>
        <p>
          {scoredOnly.length} further jurisdictions have a governance readiness score and the
          instruments it was coded from, which is a thinner record than a full index and is
          sourced the same way.
        </p>
      </div>

      <div class="scroll-x">
        <table class="grid-table">
          <caption class="visually-hidden">
            Jurisdictions with a governance readiness score but no full law index yet.
          </caption>
          <thead>
            <tr>
              <th scope="col">Jurisdiction</th>
              <th scope="col" class="ta-end">Readiness</th>
              <th scope="col" class="bar-col">
                <span class="visually-hidden">Relative readiness</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {
              scoredOnly.map((row) => (
                <tr>
                  <th scope="row">{row.name}</th>
                  <td class="ta-end num">{row.readiness}</td>
                  <td class="bar-col">
                    <span
                      class="bar bar--thin bar--gov"
                      style={`--w:${row.readiness}%`}
                      aria-hidden="true"
                    />
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="caveat">
        Readiness measures how much governance machinery exists, not how strict it is. The
        scoring rubric and every jurisdiction's cited instruments are on the
        {" "}<a href="/methodology/governance-readiness/">rubric page</a>. The 27 EU member
        states are scored once at bloc level and are not listed here.
        <Provenance source={governance.sources} retrieved={governance.retrieved} />
      </p>
    </div>
  </section>
</Base>
