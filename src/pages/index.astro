---
/**
 * The dashboard.
 *
 * One panel per section of the site, each carrying that section's headline
 * figures and nothing else, with its heading as the way in. Everything that used
 * to live here in full now lives on the page it belongs to: this page's job is
 * to tell a reader what is going on and where to click, in one screen and a bit.
 *
 * The map is the exception and is here at full width, because "where is this
 * happening" is the question a reader arrives with and a number cannot answer
 * it. It steps through reporting periods with no JavaScript; see TimeMap.
 */
import Base from "../layouts/Base.astro";
import Provenance from "../components/Provenance.astro";
import TimeMap from "../components/TimeMap.astro";
import BarTable from "../components/BarTable.astro";
import Sparkline from "../components/Sparkline.astro";
import { alpha3 } from "../lib/geo";
import { assertRenderable, freshness, type Dataset } from "../lib/sources";

import exposureFile from "../../data/processed/ai-exposure.json";
import governanceFile from "../../data/processed/governance-readiness.json";
import modelsFile from "../../data/processed/frontier-models.json";
import releasesFile from "../../data/processed/model-releases.json";
import benchmarkFile from "../../data/processed/benchmark-frontier.json";
import clusterFile from "../../data/processed/compute-clusters.json";
import thresholdFile from "../../data/processed/legal-thresholds.json";
import frameworkFile from "../../data/processed/safety-frameworks.json";
import researchFile from "../../data/processed/research-volume.json";
import policyFile from "../../data/processed/policy-index.json";
import enterpriseFile from "../../data/processed/enterprise-ai-country.json";
import feedFile from "../../data/processed/news-feed.json";
import statusFile from "../../data/processed/_status.json";
import { isSafeUrl, type NewsRecord } from "../lib/news";

interface ExposureRecord {
  entity: string;
  values: Record<string, number>;
  latest_period: string;
  latest: number;
  source_id: string;
}
interface GovernanceRecord {
  code: string;
  name: string;
  readiness: number;
  basis: string;
  source_id: string;
}
interface ModelRecord {
  model: string;
  organisation: string;
  published: string;
  compute_flop: number;
  source_id: string;
}
interface ReleaseRecord {
  model: string;
  organisation: string;
  published: string;
  accessibility: string;
  source_id: string;
}
interface BenchmarkRecord {
  benchmark: string;
  category: string;
  points: Array<{ month: string; best: number }>;
  latest_best: number;
  latest_month: string;
  saturated_month: string | null;
  months_to_saturation: number | null;
  source_id: string;
}
interface ClusterRecord {
  country: string;
  clusters: number;
  power_mw: number;
  source_id: string;
}
interface ThresholdRecord {
  jurisdiction: string;
  instrument: string;
  flop: number;
  exponent: number;
  status: string;
  source_id: string;
}
interface FrameworkRecord {
  developer: string;
  framework: string | null;
  halt: string;
  external: boolean;
  source_id: string;
}
interface ResearchRecord {
  key: string;
  role: string;
  label: string;
  points: Array<{ year: number; count: number }>;
  partial_year: number;
  source_id: string;
}
interface PolicyRecord {
  jurisdiction: string;
  jurisdiction_slug: string;
  title: string;
  force: string;
  year: number;
  source_id: string;
}
interface EnterpriseRecord {
  code: string;
  name: string;
  share: number;
  year: string;
  source_id: string;
}

const exposure = exposureFile as Dataset<ExposureRecord>;
const governance = governanceFile as Dataset<GovernanceRecord>;
const models = modelsFile as Dataset<ModelRecord>;
const releases = releasesFile as Dataset<ReleaseRecord>;
const benchmarks = benchmarkFile as Dataset<BenchmarkRecord>;
const clusters = clusterFile as Dataset<ClusterRecord>;
const thresholds = thresholdFile as Dataset<ThresholdRecord>;
const frameworks = frameworkFile as Dataset<FrameworkRecord>;
const research = researchFile as Dataset<ResearchRecord>;
const policy = policyFile as Dataset<PolicyRecord>;
const enterprise = enterpriseFile as Dataset<EnterpriseRecord>;
const feed = feedFile as Dataset<NewsRecord>;

const datasets = [
  exposure, governance, models, releases, benchmarks, clusters,
  thresholds, frameworks, research, policy, enterprise, feed,
];
const cites = [...new Set(datasets.flatMap((d) => d.sources))];
assertRenderable(...cites);

/* ---------------------------------------------------------------------------
   The map. Fixed colour breaks, not per-period quantiles.

   Quantiles recomputed per period would hold the colour distribution constant
   while the data moved, so a world getting uniformly more exposed would look
   identical in every frame. Fixed breaks mean a colour means the same share in
   every period, which is the entire point of stepping through them.
   --------------------------------------------------------------------------- */
const BREAKS = [10, 20, 30, 40];

/* Sequential ramp, one hue, ending on the accent.
   Solid steps rather than five alpha values of the accent. Alpha composites
   against whatever is behind it, and behind a country is the --surface sphere
   over the body's grid, so the low buckets picked up the pattern and the bottom
   two were nearly indistinguishable from the "no data" grey. These are opaque,
   so a bucket is the same colour wherever it falls.

   Checked rather than chosen by eye, with the dataviz skill's ordinal validator
   against the sphere colour #1b212e: lightness monotone, every adjacent step at
   least 0.06 L apart, hue spread 12 degrees, and the lowest step at 2.22:1
   against the surface, which clears the 2:1 floor that keeps the first bucket
   legible as data rather than as background. */
const RAMP = ["#63553d", "#886c41", "#ad8547", "#cf974c", "#f2a950"];
const bucketOf = (value: number) => BREAKS.filter((b) => value >= b).length;

const periods = [...new Set(exposure.records.flatMap((r) => Object.keys(r.values)))].sort();
const mapData = exposure.records
  .map((record) => {
    const code = alpha3(record.entity);
    if (!code) return null;
    return {
      code,
      fills: periods.map((p) => {
        const value = record.values[p];
        return value === undefined ? "var(--surface-2)" : RAMP[bucketOf(value)];
      }),
      title: `${record.entity}: ${record.latest.toFixed(1)}% in ${record.latest_period}`,
      href: "/adoption/",
    };
  })
  .filter((d): d is NonNullable<typeof d> => d !== null);

const legend = [
  { label: "under 10%", colour: RAMP[0] },
  { label: "10 to 20", colour: RAMP[1] },
  { label: "20 to 30", colour: RAMP[2] },
  { label: "30 to 40", colour: RAMP[3] },
  { label: "40% and over", colour: RAMP[4] },
];

const latestPeriod = periods[periods.length - 1];
const firstPeriod = periods[0];
const ranked = [...exposure.records].sort((a, b) => b.latest - a.latest);
const sortedLatest = ranked.map((r) => r.latest).sort((a, b) => a - b);
const medianExposure = sortedLatest[Math.floor(sortedLatest.length / 2)];
const risen = exposure.records.filter(
  (r) => r.values[firstPeriod] !== undefined && r.latest > r.values[firstPeriod],
).length;
const withBoth = exposure.records.filter((r) => r.values[firstPeriod] !== undefined).length;

const exposureRows = ranked.map((row) => ({
  label: row.entity,
  value: row.latest,
  display: `${row.latest.toFixed(1)}%`,
  meta:
    row.values[firstPeriod] !== undefined
      ? `${row.latest - row.values[firstPeriod] >= 0 ? "+" : ""}${(row.latest - row.values[firstPeriod]).toFixed(1)}`
      : "-",
  highlight: row.entity === "Australia",
}));

/* ---------------------------------------------------------------------------
   Panel figures. One or two numbers each; the detail is on the section page.
   --------------------------------------------------------------------------- */
const SOLVED_AT = 0.9;
const solved = benchmarks.records.filter((b) => b.saturated_month);
const openTests = benchmarks.records.filter((b) => !b.saturated_month);
const hardest = [...openTests].sort((a, b) => a.latest_best - b.latest_best)[0];
const leadBenchmark = [...benchmarks.records].sort((a, b) => b.points.length - a.points.length)[0];
const benchMonth = benchmarks.records.reduce(
  (m, b) => (b.latest_month > m ? b.latest_month : m),
  "",
);

const EU_THRESHOLD = 1e25;
const aboveEU = models.records.filter((m) => m.compute_flop >= EU_THRESHOLD).length;
const aboveCA = models.records.filter((m) => m.compute_flop >= 1e26).length;
const largest = [...models.records].sort((a, b) => b.compute_flop - a.compute_flop)[0];
const inForce = thresholds.records.filter((t) => t.status === "in force");
const latestRelease = [...releases.records].sort((a, b) => b.published.localeCompare(a.published))[0];
const powerTotal = clusters.records.reduce((sum, c) => sum + c.power_mw, 0);

const withFramework = frameworks.records.filter((f) => f.framework);
const halting = withFramework.filter((f) => f.halt === "yes");
const capabilityResearch = research.records.find((r) => r.key === "capability")!;
const completeYear = capabilityResearch.partial_year - 1;
const countAt = (r: ResearchRecord, y: number) => r.points.find((p) => p.year === y)?.count ?? 0;
const safetyWorks = research.records
  .filter((r) => r.role === "safety")
  .reduce((sum, r) => sum + countAt(r, completeYear), 0);
const capabilityWorks = countAt(capabilityResearch, completeYear);
const perHundred = capabilityWorks ? Math.round((safetyWorks / capabilityWorks) * 100) : 0;

const jurisdictions = [...new Set(policy.records.map((r) => r.jurisdiction_slug))];
const binding = policy.records.filter((r) => r.force === "statute" || r.force === "delegated");
const nationalGovernance = governance.records.filter((g) => g.basis === "national");
const topGovernance = [...nationalGovernance].sort((a, b) => b.readiness - a.readiness)[0];

const enterpriseSorted = [...enterprise.records].sort((a, b) => b.share - a.share);
const enterpriseTop = enterpriseSorted[0];
const enterpriseYear = enterprise.records[0]?.year ?? "";
/* The comparison the adoption page is built on, restated here in one number. */
const paired = enterprise.records
  .map((e) => {
    const people = exposure.records.find((x) => alpha3(x.entity) === alpha3(e.name));
    return people ? { name: e.name, firms: e.share, people: people.latest } : null;
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);
const peopleAhead = paired.filter((p) => p.people > p.firms).length;

const recentNews = [...feed.records]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6);
const jurisdictionsInFeed = new Set(
  feed.records.filter((r) => r.kind === "Government publication").map((r) => r.jurisdiction),
).size;

const status = statusFile as { last_checked: string; modules: Record<string, string> };
const checked = freshness(status.last_checked);
const failing = Object.entries(status.modules).filter(([, state]) => state !== "ok");

const fmtCompute = (flop: number) => {
  const exp = Math.floor(Math.log10(flop));
  return `${(flop / 10 ** exp).toFixed(1)}e${exp}`;
};
const pct = (v: number) => `${(v * 100).toFixed(0)}%`;

/* What each section holds. Same order as the nav, which runs outward from the
   models to the law that applies to them. One line each, stating the contents
   rather than recommending them. */
const contents = [
  { href: "/progress/", name: "Progress", desc: "Benchmark scores by category and difficulty, how long each test stayed useful, and release cadence." },
  { href: "/capability/", name: "Capability", desc: "Training compute, disclosed cost, release type, and the compute thresholds written into law." },
  { href: "/alignment/", name: "Alignment", desc: "Published frontier safety frameworks, safety against capability research volume, and reported incidents." },
  { href: "/adoption/", name: "Adoption", desc: "Population and enterprise use, by firm size, industry, technology and country." },
  { href: "/map/", name: "Map", desc: "AI use against governance readiness, by jurisdiction." },
  { href: "/policy/", name: "Policy", desc: "Instruments that apply to AI in eleven jurisdictions, tagged by how binding each one is." },
  { href: "/news/", name: "News", desc: "Official publications, preprints and reported incidents, filed by keyword." },
  { href: "/sources/", name: "Sources", desc: "Every registered source, its licence, its use here, and its stated limitations." },
  { href: "/methodology/", name: "Methodology", desc: "How each dataset is built, scored and updated." },
  { href: "/glossary/", name: "Glossary", desc: "Definitions of the terms used on this site." },
];
---

<Base
  title="AI Safety Tracker"
  root
  description="A cited index of AI capability, governance and safety. Current figures on model progress, adoption, law and incidents, with the source, licence and retrieval date on every number."
  cites={cites}
>
  <!-- BANNER. States what the site is for, and what it holds. -->
  <section class="banner">
    <div class="wrap">
      <h1 class="banner__title">Understand the current AI policy environment</h1>
      <p class="banner__lede">
        Data on AI is fragmented across publishers. This site indexes it in one place, from
        Epoch AI, Eurostat, OpenAlex, Microsoft and official government sources. Every figure
        carries its source, licence and retrieval date.
      </p>
      <p class="banner__meta mono">
        {datasets.length} datasets
        <span aria-hidden="true">/</span>
        {cites.length} sources
        <span aria-hidden="true">/</span>
        <span class={checked.stale ? "is-stale" : undefined}>checked {checked.label}</span>
        {failing.length > 0 && <span class="is-stale">/ {failing.length} source(s) failing</span>}
      </p>
    </div>
  </section>

  <!-- CONTENTS. What each section holds, in one line each. -->
  <section class="section section--open" id="contents">
    <div class="wrap">
      <div class="section-head">
        <h2>What is on this site</h2>
      </div>

      <ul class="contents">
        {
          contents.map((entry) => (
            <li class="contents__row">
              <a href={entry.href} class="contents__name">
                {entry.name}
              </a>
              <span class="contents__desc">{entry.desc}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sunk" id="metrics">
    <div class="wrap">
      <div class="section-head">
        <h2>Explore metrics</h2>
        <p>Headline figures from each section. Each heading opens the full page.</p>
      </div>

      <!-- DASHBOARD. One panel per section; the heading is the way in. -->
      <div class="dash">
        <article class="panel-card dash__wide">
          <h2 class="panel-card__head">
            <a href="/progress/" class="go">Progress</a>
            <span class="panel-card__meta mono">to {benchMonth}</span>
          </h2>
          <p class="panel-card__lead num">
            {solved.length}<span class="panel-card__of">of {benchmarks.count}</span>
          </p>
          <p class="panel-card__label">
            tracked benchmarks solved past {pct(SOLVED_AT)}
            <Provenance
              source={benchmarks.sources}
              retrieved={benchmarks.retrieved}
              label="figure"
              note="Solved means the best recorded score by any evaluated model has passed 0.9."
            />
          </p>
          <Sparkline points={leadBenchmark.points} marker={SOLVED_AT} />
          <ul class="panel-card__facts">
            <li>
              <span class="num">{pct(hardest.latest_best)}</span> best score on {hardest.benchmark}
            </li>
            <li>
              <span class="num">{openTests.length}</span> tests still separating leading models
            </li>
          </ul>
        </article>

        <article class="panel-card dash__wide">
          <h2 class="panel-card__head">
            <a href="/capability/" class="go">Capability</a>
            <span class="panel-card__meta mono">{models.count} with compute</span>
          </h2>
          <p class="panel-card__lead num">{aboveEU}</p>
          <p class="panel-card__label">
            models at or above the EU systemic-risk threshold of 1e25 FLOP
            <Provenance
              source={models.sources}
              retrieved={models.retrieved}
              label="figure"
              note="Counted from models with a reported or estimated training-compute figure. Many are estimates."
            />
          </p>
          <ul class="panel-card__facts">
            <li>
              <span class="num">{aboveCA}</span> above 1e26, the Californian threshold
            </li>
            <li>
              <span class="num">{fmtCompute(largest.compute_flop)}</span> largest run, {largest.model}
            </li>
            <li>
              <span class="num">{Math.round(powerTotal).toLocaleString("en-GB")} MW</span>
              documented cluster power
            </li>
          </ul>
        </article>

        <article class="panel-card dash__wide">
          <h2 class="panel-card__head">
            <a href="/alignment/" class="go">Alignment</a>
            <span class="panel-card__meta mono">{completeYear} research</span>
          </h2>
          <p class="panel-card__lead num">{perHundred}</p>
          <p class="panel-card__label">
            safety works published per 100 on frontier models
            <Provenance
              source={research.sources}
              retrieved={research.retrieved}
              label="figure"
              note="Keyword match on title and abstract in OpenAlex, not a field classification. The queries are printed on the alignment page."
            />
          </p>
          <ul class="panel-card__facts">
            <li>
              <span class="num">{withFramework.length} of {frameworks.count}</span> developers
              publish a safety framework
            </li>
            <li>
              <span class="num">{halting.length}</span> of those commit to stopping rather than
              deciding
            </li>
          </ul>
        </article>

        <article class="panel-card">
          <h2 class="panel-card__head">
            <a href="/adoption/" class="go">Adoption</a>
          </h2>
          <p class="panel-card__lead num">{peopleAhead}<span class="panel-card__of">of {paired.length}</span></p>
          <p class="panel-card__label">
            economies where more people use AI than the firms employing them
            <Provenance
              source={[...exposure.sources, ...enterprise.sources]}
              retrieved={enterprise.retrieved}
              label="figure"
              note="Population use from Microsoft telemetry; enterprise use from Eurostat's survey. Two different instruments, compared as levels."
            />
          </p>
          <ul class="panel-card__facts">
            <li>
              <span class="num">{enterpriseTop.share.toFixed(0)}%</span> of firms in
              {" "}{enterpriseTop.name}, the highest, {enterpriseYear}
            </li>
          </ul>
        </article>

        <article class="panel-card">
          <h2 class="panel-card__head">
            <a href="/map/" class="go">Governance</a>
          </h2>
          <p class="panel-card__lead num">{governance.count}</p>
          <p class="panel-card__label">
            jurisdictions scored for governance readiness
            <Provenance
              source={governance.sources}
              retrieved={governance.retrieved}
              label="figure"
              note="Our own coding from primary instruments. It counts machinery, not quality."
            />
          </p>
          <ul class="panel-card__facts">
            <li>
              <span class="num">{nationalGovernance.length}</span> coded individually, the rest
              inherit the EU score
            </li>
            <li>
              <span class="num">{topGovernance.readiness}</span> highest score, {topGovernance.name}
            </li>
          </ul>
        </article>

        <article class="panel-card">
          <h2 class="panel-card__head">
            <a href="/policy/" class="go">Policy</a>
          </h2>
          <p class="panel-card__lead num">{policy.count}</p>
          <p class="panel-card__label">
            instruments indexed across {jurisdictions.length} jurisdictions
            <Provenance source={policy.sources} retrieved={policy.retrieved} label="figure" />
          </p>
          <ul class="panel-card__facts">
            <li>
              <span class="num">{binding.length}</span> of them binding law
            </li>
            <li>
              <span class="num">{inForce.length}</span> compute thresholds in force anywhere
            </li>
          </ul>
        </article>

        <article class="panel-card dash__tall">
          <h2 class="panel-card__head">
            <a href="/news/" class="go">News</a>
            <span class="panel-card__meta mono">{jurisdictionsInFeed} jurisdictions</span>
          </h2>
          <ul class="mini-feed">
            {
              recentNews.map((item) => (
                <li>
                  <time class="mono" datetime={item.date}>
                    {item.date}
                  </time>
                  {/* Feed URLs are somebody else's input. Same check as NewsList. */}
                  {isSafeUrl(item.url) ? (
                    <a href={item.url}>{item.title}</a>
                  ) : (
                    <span class="feed__title--unlinked">{item.title}</span>
                  )}
                </li>
              ))
            }
          </ul>
          <a href="/news/" class="more">The full feed, by category</a>
        </article>
      </div>
    </div>
  </section>

  <!-- THE MAP -->
  <section class="section section--sunk" id="map">
    <div class="wrap">
      <div class="section-head">
        <h2><a href="/adoption/" class="go">Who is using AI</a></h2>
        <p>
          Share of each economy's working-age population actively using AI tools. Colour breaks
          are fixed across periods.
        </p>
      </div>

      <TimeMap
        periods={periods}
        data={mapData}
        legend={legend}
        label="Share of working-age population using AI tools, by economy"
        id="use"
        width={1000}
        places={1}
      />

      <div class="map-side">
        <ul class="strip">
          <li class="strip__item">
            <span class="strip__value">{medianExposure.toFixed(1)}%</span>
            <span class="strip__label">
              median economy, {latestPeriod}
              <Provenance
                source={exposure.sources}
                retrieved={exposure.retrieved}
                label="figure"
                note="Median across all 147 economies in the dataset."
              />
            </span>
          </li>
          <li class="strip__item">
            <span class="strip__value">{ranked[0].latest.toFixed(1)}%</span>
            <span class="strip__label">{ranked[0].entity}, the highest</span>
          </li>
          <li class="strip__item">
            <span class="strip__value">{risen} of {withBoth}</span>
            <span class="strip__label">economies rose between {firstPeriod} and {latestPeriod}</span>
          </li>
          <li class="strip__item">
            <span class="strip__value">{exposure.count}</span>
            <span class="strip__label">economies in the dataset</span>
          </li>
        </ul>
      </div>

      <BarTable
        rows={exposureRows}
        head="Economy"
        valueHead={`Share, ${latestPeriod}`}
        metaHead={`Change since ${firstPeriod}`}
        top={10}
        caption={`Share of working-age population using AI tools by economy in ${latestPeriod}, ranked highest to lowest, with the change since ${firstPeriod}.`}
      />

      <p class="caveat">
        Estimated from anonymised Microsoft telemetry adjusted for device and internet
        penetration. It measures Microsoft-visible use scaled by a model, not observed total AI
        use, and it cannot see AI embedded in products people do not recognise as AI. The
        tooltip on each country shows its latest value, not the value for the selected period.
        <Provenance source={exposure.sources} retrieved={exposure.retrieved} />
      </p>
    </div>
  </section>

  <!-- WHAT THIS IS -->
  <section class="section" id="about">
    <div class="wrap">
      <div class="section-head">
        <h2>Provenance</h2>
        <p>
          Each figure carries its source, licence and retrieval date, resolved from a single
          registry when the page is built.
        </p>
      </div>

      <ul class="cards">
        <li class="card">
          <span class="card__title">Markers on figures</span>
          <p>
            The marker beside a figure opens its source, publisher, licence, update cadence,
            retrieval date and stated limitations.
          </p>
        </li>
        <li class="card">
          <span class="card__title">Licence enforcement</span>
          <p>
            Artificial Analysis forbids redistribution and the Stanford AI Index is
            no-derivatives. Both are registered so that using either fails the build.
          </p>
        </li>
        <li class="card">
          <span class="card__title">No accounts or client JavaScript</span>
          <p>
            Charts and maps are rendered to SVG when the site is built. Measurement is limited to
            aggregate page counts.
          </p>
        </li>
        <li class="card">
          <a href="/sources/" class="card__title">All {cites.length} sources</a>
          <p>Every source, its licence, its use here and its stated limitations.</p>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------------------------
     Banner.

     The design lock says no marketing hero; the site owner asked for a banner,
     and the owner's instruction wins. What is kept from the lock is the
     vocabulary: the background is four CSS gradients and no image, because there
     are no images on this site and a banner is not a reason to start.

     The layers, back to front: a warm amber wash off the top right, a cool wash
     off the bottom left to stop the warm one reading as a colour cast, the same
     56px graph paper the body carries but at twice the contrast, and a fade to
     --bg at the bottom edge so the banner resolves into the page instead of
     ending on a line. Every one of them is far below text contrast; the type
     sits on --bg, not on the wash.
     --------------------------------------------------------------------------- */
  .banner {
    position: relative;
    padding-block: clamp(2.25rem, 6vw, 4rem) clamp(1.75rem, 4vw, 2.75rem);
    border-block-end: 1px solid var(--line);
    background-color: var(--bg);
    background-image:
      radial-gradient(70ch 40ch at 88% -10%, rgb(242 169 80 / 0.16), transparent 70%),
