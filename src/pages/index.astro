---
/**
 * The dashboard.
 *
 * One panel per section of the site, each carrying that section's headline
 * figures and nothing else, with its heading as the way in. Everything that used
 * to live here in full now lives on the page it belongs to: this page's job is
 * to tell a reader what is going on and where to click, in one screen and a bit.
 *
 * The map is the exception and is here at full width, because "where is this
 * happening" is the question a reader arrives with and a number cannot answer
 * it. It steps through reporting periods with no JavaScript; see TimeMap.
 */
import Base from "../layouts/Base.astro";
import TimeMap from "../components/TimeMap.astro";
import BarTable from "../components/BarTable.astro";
import { alpha3 } from "../lib/geo";
import { assertRenderable, freshness, type Dataset } from "../lib/sources";

import exposureFile from "../../data/processed/ai-exposure.json";
import governanceFile from "../../data/processed/governance-readiness.json";
import modelsFile from "../../data/processed/frontier-models.json";
import releasesFile from "../../data/processed/model-releases.json";
import benchmarkFile from "../../data/processed/benchmark-frontier.json";
import clusterFile from "../../data/processed/compute-clusters.json";
import thresholdFile from "../../data/processed/legal-thresholds.json";
import frameworkFile from "../../data/processed/safety-frameworks.json";
import researchFile from "../../data/processed/research-volume.json";
import policyFile from "../../data/processed/policy-index.json";
import enterpriseFile from "../../data/processed/enterprise-ai-country.json";
import feedFile from "../../data/processed/news-feed.json";
import statusFile from "../../data/processed/_status.json";
import { isSafeUrl, type NewsRecord } from "../lib/news";

interface ExposureRecord {
  entity: string;
  values: Record<string, number>;
  latest_period: string;
  latest: number;
  source_id: string;
}
interface GovernanceRecord {
  code: string;
  name: string;
  readiness: number;
  basis: string;
  source_id: string;
}
interface ModelRecord {
  model: string;
  organisation: string;
  published: string;
  compute_flop: number;
  source_id: string;
}
interface ReleaseRecord {
  model: string;
  organisation: string;
  published: string;
  accessibility: string;
  source_id: string;
}
interface BenchmarkRecord {
  benchmark: string;
  category: string;
  points: Array<{ month: string; best: number }>;
  latest_best: number;
  latest_month: string;
  saturated_month: string | null;
  months_to_saturation: number | null;
  source_id: string;
}
interface ClusterRecord {
  country: string;
  clusters: number;
  power_mw: number;
  source_id: string;
}
interface ThresholdRecord {
  jurisdiction: string;
  instrument: string;
  flop: number;
  exponent: number;
  status: string;
  source_id: string;
}
interface FrameworkRecord {
  developer: string;
  framework: string | null;
  halt: string;
  external: boolean;
  source_id: string;
}
interface ResearchRecord {
  key: string;
  role: string;
  label: string;
  points: Array<{ year: number; count: number }>;
  partial_year: number;
  source_id: string;
}
interface PolicyRecord {
  jurisdiction: string;
  jurisdiction_slug: string;
  title: string;
  force: string;
  year: number;
  source_id: string;
}
interface EnterpriseRecord {
  code: string;
  name: string;
  share: number;
  year: string;
  source_id: string;
}

const exposure = exposureFile as Dataset<ExposureRecord>;
const governance = governanceFile as Dataset<GovernanceRecord>;
const models = modelsFile as Dataset<ModelRecord>;
const releases = releasesFile as Dataset<ReleaseRecord>;
const benchmarks = benchmarkFile as Dataset<BenchmarkRecord>;
const clusters = clusterFile as Dataset<ClusterRecord>;
const thresholds = thresholdFile as Dataset<ThresholdRecord>;
const frameworks = frameworkFile as Dataset<FrameworkRecord>;
const research = researchFile as Dataset<ResearchRecord>;
const policy = policyFile as Dataset<PolicyRecord>;
const enterprise = enterpriseFile as Dataset<EnterpriseRecord>;
const feed = feedFile as Dataset<NewsRecord>;

const datasets = [
  exposure, governance, models, releases, benchmarks, clusters,
  thresholds, frameworks, research, policy, enterprise, feed,
];
const cites = [...new Set(datasets.flatMap((d) => d.sources))];
assertRenderable(...cites);

/* ---------------------------------------------------------------------------
   The map. Fixed colour breaks, not per-period quantiles.

   Quantiles recomputed per period would hold the colour distribution constant
   while the data moved, so a world getting uniformly more exposed would look
   identical in every frame. Fixed breaks mean a colour means the same share in
   every period, which is the entire point of stepping through them.
   --------------------------------------------------------------------------- */
const BREAKS = [10, 20, 30, 40];

/* Sequential ramp, one hue, ending on the accent.
   Solid steps rather than five alpha values of the accent. Alpha composites
   against whatever is behind it, and behind a country is the --surface sphere
   over the body's grid, so the low buckets picked up the pattern and the bottom
   two were nearly indistinguishable from the "no data" grey. These are opaque,
   so a bucket is the same colour wherever it falls.

   Checked rather than chosen by eye, with the dataviz skill's ordinal validator
   against the sphere colour #1b212e: lightness monotone, every adjacent step at
   least 0.06 L apart, hue spread 12 degrees, and the lowest step at 2.22:1
   against the surface, which clears the 2:1 floor that keeps the first bucket
   legible as data rather than as background. */
const RAMP = ["#63553d", "#886c41", "#ad8547", "#cf974c", "#f2a950"];
const bucketOf = (value: number) => BREAKS.filter((b) => value >= b).length;

const periods = [...new Set(exposure.records.flatMap((r) => Object.keys(r.values)))].sort();
const mapData = exposure.records
  .map((record) => {
    const code = alpha3(record.entity);
    if (!code) return null;
    return {
      code,
      fills: periods.map((p) => {
        const value = record.values[p];
        return value === undefined ? "var(--surface-2)" : RAMP[bucketOf(value)];
      }),
      title: `${record.entity}: ${record.latest.toFixed(1)}% in ${record.latest_period}`,
      /* No href. TimeMap renders <a href={datum.href ?? undefined}>, so omitting
         it yields an anchor that is neither a link nor a tab stop, while
         .tm__link:hover .tm__shape is unaffected. With one it emitted 145
         identical links to /adoption/ from the entry page, all tabbable, out of
         231 focusable elements: a keyboard reader met every country before
         reaching anything else, and a crawler met 145 anchor-text-free links to
         one URL. Section 04 already carries the button. The /map/ links stay;
         those resolve to distinct table rows. */
    };
  })
  .filter((d): d is NonNullable<typeof d> => d !== null);

const legend = [
  { label: "under 10%", colour: RAMP[0] },
  { label: "10 to 20", colour: RAMP[1] },
  { label: "20 to 30", colour: RAMP[2] },
  { label: "30 to 40", colour: RAMP[3] },
  { label: "40% and over", colour: RAMP[4] },
];

const latestPeriod = periods[periods.length - 1];
const firstPeriod = periods[0];
const ranked = [...exposure.records].sort((a, b) => b.latest - a.latest);
const sortedLatest = ranked.map((r) => r.latest).sort((a, b) => a - b);
const medianExposure = sortedLatest[Math.floor(sortedLatest.length / 2)];
const risen = exposure.records.filter(
  (r) => r.values[firstPeriod] !== undefined && r.latest > r.values[firstPeriod],
).length;
const withBoth = exposure.records.filter((r) => r.values[firstPeriod] !== undefined).length;

const exposureRows = ranked.map((row) => ({
  label: row.entity,
  value: row.latest,
  display: `${row.latest.toFixed(1)}%`,
  meta:
    row.values[firstPeriod] !== undefined
      ? `${row.latest - row.values[firstPeriod] >= 0 ? "+" : ""}${(row.latest - row.values[firstPeriod]).toFixed(1)}`
      : "-",
  highlight: row.entity === "Australia",
}));

/* ---------------------------------------------------------------------------
   Panel figures. One or two numbers each; the detail is on the section page.
   --------------------------------------------------------------------------- */
const SOLVED_AT = 0.9;
const solved = benchmarks.records.filter((b) => b.saturated_month);
const openTests = benchmarks.records.filter((b) => !b.saturated_month);
const hardest = [...openTests].sort((a, b) => a.latest_best - b.latest_best)[0];
const leadBenchmark = [...benchmarks.records].sort((a, b) => b.points.length - a.points.length)[0];
const benchMonth = benchmarks.records.reduce(
  (m, b) => (b.latest_month > m ? b.latest_month : m),
  "",
);

const EU_THRESHOLD = 1e25;
const aboveEU = models.records.filter((m) => m.compute_flop >= EU_THRESHOLD).length;
const aboveCA = models.records.filter((m) => m.compute_flop >= 1e26).length;
const largest = [...models.records].sort((a, b) => b.compute_flop - a.compute_flop)[0];
const inForce = thresholds.records.filter((t) => t.status === "in force");
const latestRelease = [...releases.records].sort((a, b) => b.published.localeCompare(a.published))[0];
const powerTotal = clusters.records.reduce((sum, c) => sum + c.power_mw, 0);

const withFramework = frameworks.records.filter((f) => f.framework);
const halting = withFramework.filter((f) => f.halt === "yes");
const capabilityResearch = research.records.find((r) => r.key === "capability")!;
const completeYear = capabilityResearch.partial_year - 1;
const countAt = (r: ResearchRecord, y: number) => r.points.find((p) => p.year === y)?.count ?? 0;
const safetyWorks = research.records
  .filter((r) => r.role === "safety")
  .reduce((sum, r) => sum + countAt(r, completeYear), 0);
const capabilityWorks = countAt(capabilityResearch, completeYear);
const perHundred = capabilityWorks ? Math.round((safetyWorks / capabilityWorks) * 100) : 0;

const jurisdictions = [...new Set(policy.records.map((r) => r.jurisdiction_slug))];
const binding = policy.records.filter((r) => r.force === "statute" || r.force === "delegated");
const nationalGovernance = governance.records.filter((g) => g.basis === "national");
const topGovernance = [...nationalGovernance].sort((a, b) => b.readiness - a.readiness)[0];

const enterpriseSorted = [...enterprise.records].sort((a, b) => b.share - a.share);
const enterpriseTop = enterpriseSorted[0];
const enterpriseYear = enterprise.records[0]?.year ?? "";
/* The comparison the adoption page is built on, restated here in one number. */
const paired = enterprise.records
  .map((e) => {
    const people = exposure.records.find((x) => alpha3(x.entity) === alpha3(e.name));
    return people ? { name: e.name, firms: e.share, people: people.latest } : null;
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);
const peopleAhead = paired.filter((p) => p.people > p.firms).length;

const recentNews = [...feed.records]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6);
const jurisdictionsInFeed = new Set(
  feed.records.filter((r) => r.kind === "Government publication").map((r) => r.jurisdiction),
).size;

const status = statusFile as { last_checked: string; modules: Record<string, string> };
const checked = freshness(status.last_checked);
const failing = Object.entries(status.modules).filter(([, state]) => state !== "ok");

const fmtCompute = (flop: number) => {
  const exp = Math.floor(Math.log10(flop));
  return `${(flop / 10 ** exp).toFixed(1)}e${exp}`;
};
const pct = (v: number) => `${(v * 100).toFixed(0)}%`;

/* ---------------------------------------------------------------------------
   Proportion matrices.

   A ratio drawn as cells rather than as a bar: 7 of 17, 15 per 100, 46 of 78.
   The cells are generated from the figures themselves, so the picture can never
   disagree with the number beside it.
   --------------------------------------------------------------------------- */
const cells = (total: number, on: number) =>
  Array.from({ length: total }, (_, i) => i < on);

/* ---------------------------------------------------------------------------
   Hero pins.

   Three fixed countries, each anchored to its own position in the map's 1000x500
   projection, with the value read from the data rather than written here. The
   anchor is the country; the number is whatever the latest refresh says it is,
   and the rank label is computed, so a pin cannot claim a standing it no longer
   holds.
   --------------------------------------------------------------------------- */
const PIN_SITES = [
  { entity: "South Korea", x: 835, y: 170, cx: 720, cy: 32, left: "70%", top: "4%" },
  { entity: "United Arab Emirates", x: 650, y: 206, cx: 720, cy: 187, left: "70%", top: "35%" },
  { entity: "Australia", x: 860, y: 381, cx: 640, cy: 342, left: "62%", top: "66%" },
];

const pins = PIN_SITES.map((site) => {
  const record = ranked.find((r) => r.entity === site.entity);
  if (!record) return null;
  const rank = ranked.indexOf(record) + 1;
  const before = record.values[firstPeriod];
  const change = before === undefined ? null : record.latest - before;
  return {
    ...site,
    label: rank === 1 ? "Highest" : `Ranked ${rank}`,
    value: `${record.latest.toFixed(1)}%`,
    text:
      change === null
        ? `${record.entity}, ${record.latest_period}.`
        : `${record.entity}, up ${change.toFixed(1)} points since ${firstPeriod}.`,
  };
}).filter((p): p is NonNullable<typeof p> => p !== null);
---

<Base
  title="AI Safety Tracker"
  root
  description="A cited index of AI capability, governance and safety. Current figures on model progress, adoption, law and incidents, with the source and retrieval date on every number."
  cites={cites}
>
  <!-- ===================== HERO =====================
       Edge to edge: the map is the ground of the page, not a figure inside it.
       The headline sits over its quiet left side and three pins sit over its
       right, each joined to its country by a leader line drawn in the map's own
       projection. Below about 980px the map cannot carry both, and the media
       query at the foot of this file takes the overlay apart. -->
  <section class="hero" id="map" data-accent="adoption">
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="hero__overlay">
      <div class="wrap">
        <div class="hero__head">
          <span class="eyebrow">Adoption / {latestPeriod}</span>
          {/* The space between the two spans is load-bearing. They are display: block,
              so it renders as nothing and the layout is unchanged, but without it the
              h1's text content is "The numbersbehind AI" to anything reading the
              markup rather than the rendered box. */}
          <h1 class="hero__title"><span>The numbers</span> <span class="quiet">behind AI</span></h1>
          <p class="hero__lede">
            A current index of AI capability, governance and safety, drawn from {datasets.length}
            {" "}datasets and kept up to date.
          </p>
          <p class="hero__meta mono">
            {datasets.length} datasets
            <span aria-hidden="true">/</span>
            {cites.length} sources
            <span aria-hidden="true">/</span>
            <span class={checked.stale ? "is-stale" : undefined}>checked {checked.label}</span>
            {failing.length > 0 && <span class="is-stale">/ {failing.length} source(s) failing</span>}
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="#progress">Read the figures</a>
            <a class="btn btn--ghost" href="/news/">Latest</a>
          </div>
        </div>
      </div>
    </div>

    <div class="hero__map">
      <TimeMap
        periods={periods}
        data={mapData}
        legend={legend}
        label="Share of working-age population using AI tools, by economy"
        id="tm-home"
        scrub={false}
        width={2700}
        places={0}
        stroke={3}
      >
        <div class="hero__over" slot="overlay">
          <div class="scrim" aria-hidden="true"></div>
          <svg
            class="leads"
            viewBox="0 0 1000 500"
            preserveAspectRatio="xMidYMid meet"
            aria-hidden="true"
            focusable="false"
          >
            {
              pins.map((pin) => (
                <>
                  <line x1={pin.x} y1={pin.y} x2={pin.cx} y2={pin.cy} />
                  <circle cx={pin.x} cy={pin.y} r="2.5" />
                </>
              ))
            }
          </svg>

          <div class="pins">
            {
              pins.map((pin) => (
                <div class="pin" style={`left:${pin.left};top:${pin.top}`}>
                  <span class="pin__lab">{pin.label}</span>
                  <span class="pin__fig num">{pin.value}</span>
                  <span class="pin__txt">{pin.text}</span>
                </div>
              ))
            }
          </div>
        </div>
      </TimeMap>
    </div>

  </section>

  <!-- ===================== STAT BAND ===================== -->
  <div class="wrap band">
    <div class="statband">
      <div class="stat">
        <b class="num">{solved.length}<small> / {benchmarks.count}</small></b>
        <span>benchmarks solved past {pct(SOLVED_AT)}</span>
      </div>
      <div class="stat">
        <b class="num">{aboveEU}</b>
        <span>models at or above 1e25 FLOP</span>
      </div>
      <div class="stat">
        <b class="num">{perHundred}<small> / 100</small></b>
        <span>safety works per hundred on frontier models</span>
      </div>
      <div class="stat">
        <b class="num">{risen}<small> / {withBoth}</small></b>
        <span>economies where use rose since {firstPeriod}</span>
      </div>
      <div class="stat">
        <b class="num">{binding.length}<small> / {policy.count}</small></b>
        <span>policy instruments that are binding law</span>
      </div>
      <div class="stat">
        <b class="num">{governance.count}</b>
        <span>jurisdictions scored for readiness</span>
      </div>
    </div>
  </div>

  <!-- ===================== 01 PROGRESS ===================== -->
  <section class="section section--sunk" id="progress" data-accent="progress" aria-labelledby="progress-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">01 / Progress</span>
          <h2 class="sec-title" id="progress-h">
            {solved.length} of {benchmarks.count} tests are finished
          </h2>
        </div>
        <p class="sec-lede">
          A benchmark counts as solved once the best score recorded by any evaluated model passes
          {" "}{pct(SOLVED_AT)}. At that point it has stopped telling models apart.
        </p>
      </div>

      <div class="figure">
        <div
          class="matrix"
          role="img"
          aria-label={`${benchmarks.count} cells, ${solved.length} filled, showing ${solved.length} of ${benchmarks.count} tracked benchmarks solved past ${pct(SOLVED_AT)}.`}
        >
          {cells(benchmarks.count, solved.length).map((on) => <i class={on ? "on" : undefined} />)}
        </div>
        <div class="figure__read">
          <b class="num">{solved.length} of {benchmarks.count}</b>
          <p>
            Scores run to {benchMonth}. {openTests.length} tests still separate the leading models.
          </p>
        </div>
      </div>

      <div class="meter">
        <div class="meter__head">
          <span class="meter__name">{hardest.benchmark}, the hardest test still open</span>
          <span class="num meter__val">{pct(hardest.latest_best)}</span>
        </div>
        <div
          class="meter__track"
          role="img"
          aria-label={`Best recorded score on ${hardest.benchmark} is ${pct(hardest.latest_best)}.`}
        >
          <div class="meter__fill" style={`width:${Math.max(hardest.latest_best * 100, 0.5)}%`}></div>
        </div>
        <p class="meter__note">The best score recorded by any evaluated model.</p>
      </div>

      <div class="sec-foot">
        <a class="btn btn--go" href="/progress/">Explore progress</a>
        <p class="srcline">
          Data: <a href="https://epoch.ai/data/ai-benchmarking-dashboard">Epoch AI, AI Benchmarking Hub</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== 02 CAPABILITY ===================== -->
  <section class="section section--band" id="capability" data-accent="capability" aria-labelledby="capability-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">02 / Capability</span>
          <h2 class="sec-title" id="capability-h">The numbers written into law</h2>
        </div>
        <p class="sec-lede">
          Training compute is the one part of AI regulation that is arithmetic rather than
          judgement. These are the models that cross each threshold.
        </p>
      </div>

      <div class="ladder">
        <div class="rung">
          <span class="rung__x num">{fmtCompute(largest.compute_flop)}</span>
          <span class="rung__what">{largest.model}, the largest disclosed training run</span>
          <span class="rung__n num">1</span>
        </div>
        <div class="rung rung--law">
          <span class="rung__x num">1e26</span>
          <span class="rung__what">Californian threshold</span>
          <span class="rung__n num">{aboveCA}</span>
        </div>
        <div class="rung rung--law">
          <span class="rung__x num">1e25</span>
          <span class="rung__what">EU systemic-risk threshold</span>
          <span class="rung__n num">{aboveEU}</span>
        </div>
        <div class="rung">
          <span class="rung__x">Below</span>
          <span class="rung__what">Every other model with a reported or estimated figure</span>
          <span class="rung__n num">{models.count - aboveEU}</span>
        </div>
      </div>

      <div class="tagrow">
        <span class="tag">{models.count} models with a compute figure</span>
        <span class="tag">{inForce.length} thresholds in force</span>
        <span class="tag">{Math.round(powerTotal).toLocaleString("en-GB")} MW documented cluster power</span>
      </div>

      <div class="sec-foot">
        <a class="btn btn--go" href="/capability/">Explore capability</a>
        <p class="srcline">
          Data: <a href="https://epoch.ai/data/notable-ai-models">Epoch AI, Notable AI Models</a>.
          Compute figures are frequently estimates.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== 03 ALIGNMENT ===================== -->
  <section class="section section--sunk" id="alignment" data-accent="alignment" aria-labelledby="alignment-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">03 / Alignment</span>
          <h2 class="sec-title" id="alignment-h">
            {perHundred} safety papers per hundred
          </h2>
        </div>
        <p class="sec-lede">
          Published work on AI safety counted against published work on frontier models, for
          {" "}{completeYear}, the last complete year. Counted by keyword match rather than by field,
          so the definition is arguable.
        </p>
      </div>

      <div class="figure figure--wide">
        <div
          class="matrix matrix--100"
          role="img"
          aria-label={`One hundred cells, ${perHundred} filled, showing ${perHundred} safety works published for every hundred on frontier models in ${completeYear}.`}
        >
          {cells(100, perHundred).map((on) => <i class={on ? "on" : undefined} />)}
        </div>
        <div class="figure__read">
          <b class="num">{perHundred}</b>
          <p>
            For every hundred works published on frontier models in {completeYear}, {perHundred}
            {" "}were published on safety.
          </p>
          <p class="figure__note">
            Recent years undercount, because indexing lags publication.
          </p>
        </div>
      </div>

      <div class="cards">
        <article class="mini">
          <span class="mini__n mono">01</span>
          <span class="mini__fig num">{withFramework.length} of {frameworks.count}</span>
          <h3>Publish a framework</h3>
          <p>
            Developers running frontier-scale training that publish a frontier safety framework.
            The rest publish nothing, and the absence is the finding.
          </p>
        </article>
        <article class="mini">
          <span class="mini__n mono">02</span>
          <span class="mini__fig num">{halting.length}</span>
          <h3>Commit to stopping</h3>
          <p>
            Of those that publish, the number committing to halting development at a stated
            capability level rather than to deciding what to do when they reach one.
          </p>
        </article>
        <article class="mini">
          <span class="mini__n mono">03</span>
          <span class="mini__fig num">{frameworks.count}</span>
          <h3>Incomparable scales</h3>
          <p>
            No two frameworks use the same capability thresholds or the same names for them, so
            the column that matters is what each one commits to doing.
          </p>
        </article>
      </div>

      <div class="sec-foot">
        <a class="btn btn--go" href="/alignment/">Explore alignment</a>
        <p class="srcline">
          Data: <a href="https://openalex.org/">OpenAlex</a>, and our own index of published safety
          frameworks
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== 04 ADOPTION ===================== -->
  <section class="section section--band" id="adoption" data-accent="adoption" aria-labelledby="adoption-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">04 / Adoption</span>
          <h2 class="sec-title" id="adoption-h">Who is actually using it</h2>
        </div>
        <p class="sec-lede">
          Share of each economy's working-age population actively using AI tools in
          {" "}{latestPeriod}, ranked, with the change since {firstPeriod}.
        </p>
      </div>

      <div class="tagrow">
        <span class="tag">{medianExposure.toFixed(1)}% median economy</span>
        <span class="tag">{ranked[0].latest.toFixed(1)}% {ranked[0].entity}, the highest</span>
        <span class="tag">{peopleAhead} of {paired.length} economies where more people use AI than firms</span>
        <span class="tag">{enterpriseTop.share.toFixed(0)}% of firms in {enterpriseTop.name}, {enterpriseYear}</span>
      </div>

      <BarTable
        rows={exposureRows}
        head="Economy"
        valueHead={`Share, ${latestPeriod}`}
        metaHead={`Change since ${firstPeriod}`}
        caption={`Share of working-age population using AI tools by economy in ${latestPeriod}, ranked highest to lowest, with the change since ${firstPeriod}.`}
      />

      <div class="sec-foot">
        <a class="btn btn--go" href="/adoption/">Explore adoption</a>
        <p class="srcline">
          Data: <a href="https://github.com/microsoft/AIDiffusionReport">Microsoft AI for Good Lab</a>
          {" "}and <a href="https://ec.europa.eu/eurostat/web/main/data/database">Eurostat</a>.
          Microsoft-visible use, scaled, not observed total use.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== 05 POLICY ===================== -->
  <section class="section section--sunk" id="policy" data-accent="policy" aria-labelledby="policy-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">05 / Policy and governance</span>
          <h2 class="sec-title" id="policy-h">
            {binding.length} of {policy.count} are binding
          </h2>
        </div>
        <p class="sec-lede">
          Instruments indexed across {jurisdictions.length} jurisdictions, read from the primary
          source. Binding means a statute or delegated legislation; the rest is guidance, standards
          and strategy.
        </p>
      </div>

      <div class="figure">
        <div
          class="matrix"
          role="img"
          aria-label={`${policy.count} cells, ${binding.length} filled, showing ${binding.length} of ${policy.count} indexed instruments are binding law.`}
        >
          {cells(policy.count, binding.length).map((on) => <i class={on ? "gov" : undefined} />)}
        </div>
        <div class="figure__read">
          <b class="num">{binding.length} of {policy.count}</b>
          <p>
            {governance.count} jurisdictions are separately scored for governance readiness,
            {" "}{nationalGovernance.length} of them coded individually.
          </p>
          <p class="figure__note">
            Australia is indexed far more deeply than the rest, because it was indexed first, so the
            totals are not a comparison between jurisdictions.
          </p>
        </div>
      </div>

      <div class="sec-foot">
        <a class="btn btn--go" href="/policy/">Explore policy</a>
        <p class="srcline">
          Data: our own index of primary legal instruments, alongside the
          {" "}<a href="/methodology/governance-readiness/">governance readiness rubric</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== 06 NEWS ===================== -->
  <section class="section section--band" id="news" data-accent="news" aria-labelledby="news-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">06 / The wire</span>
          <h2 class="sec-title" id="news-h">Official publications and preprints</h2>
        </div>
        <p class="sec-lede">
          Government publications, preprints and reported incidents, filed by keyword and linking to
          the publisher rather than to a copy. {jurisdictionsInFeed} jurisdictions in the current feed.
        </p>
      </div>

      <ul class="feed">
        {
          recentNews.map((item) => (
            <li>
              <time class="mono" datetime={item.date}>
                {item.date}
              </time>
              <span class="badge">{item.kind}</span>
              {/* Feed URLs are somebody else's input. Same check as NewsList. */}
              {isSafeUrl(item.url) ? (
                <a href={item.url}>{item.title}</a>
              ) : (
                <span class="feed__unlinked">{item.title}</span>
              )}
            </li>
          ))
        }
      </ul>

      <div class="sec-foot">
        <a class="btn btn--go" href="/news/">Explore the news feed</a>
        <p class="srcline">
          Feeds: arXiv, the US Federal Register, NIST, GOV.UK, the European Commission and three
          others
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* =========================================================================
     HERO. The map runs the full width of the viewport and everything else in
     here is layered over it.
     ====================================================================== */
  /* No padding above the map. The scrim that closes the map into the ground
     stops at the plot box, so any gap between the header and the map top showed
     as a lighter strip with a hard edge under it: a band that read as a separate
     element rather than as the top of the map. The header is translucent and
     sticky, so the map running under it is the intended join. The stacked
     layout below 980px puts the headline here instead and takes the padding
     back, in the media query at the foot of this file. */
  .hero {
    position: relative;
    overflow: hidden;
  }

  /* Arrival, in two beats. The map resolves out of the ground over a couple of
     seconds and the headline arrives over the top of it part way through,
     rather than waiting for it to finish.

     The map fades opacity and moves nothing. It wraps 145 country paths, a
     second SVG of leader lines and three positioned cards, and animating a
     transform across that subtree makes a phone re-composite the whole of it
     every frame: on a mid-range handset the entrance stutters or is dropped
     outright, which is where this was weakest. Opacity alone is one layer and
     no relayout. The headline is a small box and can afford the 16px it rises.

     The curve carries as much of this as the duration does. --ease is an expo
     curve that is 79 percent done in the first fifth of its run, so hanging a
     long duration off it reads as a short fade with a long tail rather than as
     a slow one. The map gets a near-linear curve, so the time is spent where it
     can be seen. The headline keeps --ease, because a short move wants the
     settle. */
  @keyframes hero-map-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hero-text-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__glow {
    position: absolute;
    inset: -25% -5% auto -5%;
    block-size: 160%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 55% at 68% 42%, rgb(56 104 170 / 0.55) 0%, rgb(30 58 104 / 0.26) 44%, transparent 72%),
      radial-gradient(ellipse 70% 65% at 8% 20%, rgb(24 48 92 / 0.55) 0%, transparent 62%);
  }

  .hero__map {
    position: relative;
    z-index: 1;
    animation: hero-map-in 2600ms cubic-bezier(0.32, 0, 0.24, 1) both;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .hero__overlay .wrap {
    inline-size: 100%;
  }

  .hero__head {
    inline-size: min(48%, 580px);
    pointer-events: auto;
    /* Starts while the map is still at about a third of its fade and settles
       well before it, so the headline lands on top of a map that is still
       arriving rather than after one that has already stopped. */
    animation: hero-text-in 1400ms var(--ease) 800ms both;
  }

  /* Below both, so it overrides both: equal specificity, and source order
     decides. */
  @media (prefers-reduced-motion: reduce) {
    .hero__map,
    .hero__head {
      animation: none;
    }
  }

  .hero__title span {
    display: block;
  }

  .hero__title .quiet {
    color: var(--muted);
    font-weight: 300;
  }

  .hero__title {
    margin-block: 0.75rem 1rem;
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .hero__lede {
    max-inline-size: 44ch;
    color: var(--muted);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 0.9rem;
    font-size: 0.75rem;
    color: var(--muted-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.5rem;
  }

  /* =========================================================================
     STAT BAND
     ====================================================================== */
  .band {
    display: block;
    /* Give the summary its own breathing room on both sides. With no bottom
       padding the rounded strip touched the field-tinted rule at the start of
       01 / Progress and read like it had been clipped into the next section. */
    padding-block: 2rem;
  }

  .statband {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.035), transparent 40%), var(--surface);
    overflow: hidden;
  }

  .stat {
    padding: 1.25rem;
    border-inline-start: 1px solid var(--line-soft);
  }

  .stat:first-child {
    border-inline-start: 0;
  }

  .stat b {
    display: block;
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stat b small {
    font-size: 0.875rem;
    color: var(--muted-2);
    letter-spacing: -0.01em;
  }

  .stat span {
    display: block;
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  /* =========================================================================
     SECTIONS
     ====================================================================== */
  .section {
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
  }

  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 2.5rem;
    align-items: end;
    margin-block-end: 2.5rem;
  }

  .sec-title {
    margin-block-start: 0.85rem;
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .sec-lede {
    color: var(--muted);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .figure {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 2.5rem;
    align-items: center;
  }

  /* A definite track, so the square inside it has something to be 100% of. */
  .figure--wide {
    grid-template-columns: 296px minmax(0, 1fr);
  }

  .figure__read b {
    display: block;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .figure__read p {
    max-inline-size: 44ch;
    margin-block-start: 0.75rem;
    color: var(--muted);
  }

  .figure__note {
    color: var(--muted-2);
    font-size: 0.8125rem;
  }

  /* --- Proportion matrices ------------------------------------------------ */
  .matrix {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .matrix i {
    display: block;
    inline-size: 22px;
    block-size: 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-mark);
  }

  .matrix i.on {
    background: var(--accent);
    border-color: var(--accent);
  }

  .matrix i.gov {
    background: var(--accent-2);
    border-color: var(--accent-2);
  }

  /* One hundred cells resolve to a square rather than a ragged wrap. */
  .matrix--100 {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 5px;
    inline-size: 100%;
  }

  .matrix--100 i {
    inline-size: auto;
    block-size: auto;
    aspect-ratio: 1;
  }

  /* --- The one measured bar ---------------------------------------------- */
  .meter {
    max-inline-size: 620px;
    margin-block-start: 2rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line-soft);
  }

  .meter__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-end: 0.75rem;
  }

  .meter__name {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .meter__val {
    font-size: 1.25rem;
  }

  .meter__track {
    block-size: 12px;
    border: 1px solid var(--line-soft);
    border-radius: var(--r-mark);
    background: var(--bg-deep);
    overflow: hidden;
  }

  .meter__fill {
    block-size: 100%;
    background: var(--accent);
    border-radius: var(--r-mark);
  }

  .meter__note {
    margin-block-start: 0.75rem;
    color: var(--muted-2);
    font-size: 0.8125rem;
  }

  /* --- Compute ladder ----------------------------------------------------- */
  .ladder {
    max-inline-size: 880px;
  }

  .rung {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-block-start: 1px dashed var(--line);
  }

  .rung:first-child {
    border-block-start: 0;
  }

  .rung--law {
    border-block-start-style: solid;
    border-block-start-color: var(--accent-line);
  }

  .rung__x {
    color: var(--muted-2);
    font-size: 0.875rem;
  }

  .rung--law .rung__x {
    color: var(--accent-ink);
  }

  .rung__what {
    color: var(--muted);
  }

  .rung--law .rung__what {
    color: var(--ink);
  }

  .rung__n {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .tagrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1.5rem;
  }

  /* .tag is nowrap globally, which is right for a one or two word chip and
     wrong here: these carry a whole clause, and the longest of them rendered a
     331px pill that pushed the document 27px past a 320px viewport. Scoped to
     .tagrow because that class is only used on this page. */
  .tagrow .tag {
    white-space: normal;
  }

  /* --- Numbered cards ----------------------------------------------------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-block-start: 2.5rem;
  }

  .mini {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--surface);
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }

  .mini:hover {
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }

  .mini__n {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-end: 1.25rem;
    color: var(--muted-2);
    font-size: 0.625rem;
  }

  .mini__fig {
    display: block;
    margin-block-end: 0.5rem;
    font-size: 1.625rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .mini h3 {
    margin-block-end: 0.5rem;
    padding-inline-end: 2rem;
  }

  .mini p {
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /* --- The wire ----------------------------------------------------------- */
  .feed {
    max-inline-size: 1020px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feed li {
    display: grid;
    grid-template-columns: 104px 148px 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-block-start: 1px solid var(--line-soft);
  }

  .feed time {
    color: var(--muted-2);
    font-size: 0.6875rem;
  }

  .feed a {
    color: var(--ink);
    text-decoration: none;
  }

  .feed a:hover {
    color: var(--accent-ink);
  }

  .feed__unlinked {
    color: var(--muted);
  }

  .badge {
    display: inline-block;
    padding: 2px 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    color: var(--muted-2);
    font-family: var(--f-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .is-stale {
    color: var(--warn);
  }

  /* =========================================================================
     RESPONSIVE
     ====================================================================== */
  @media (max-width: 1180px) {
    .statband {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .stat:nth-child(3n + 1) {
      border-inline-start: 0;
    }

    .stat:nth-child(n + 4) {
      border-block-start: 1px solid var(--line-soft);
    }

    .hero__head {
      inline-size: min(52%, 500px);
    }
  }

  @media (max-width: 980px) {
    /* Below this the map cannot carry a headline and pinned cards at once. The
       overlay comes apart: the headline goes above the map, the leader lines go
       entirely, and the pins become a plain stack underneath. */
    .hero {
      display: flex;
      flex-direction: column;
      /* The headline is the first thing in the hero here, not the map, so it
         needs the gap back that the map did not want. */
      padding-block-start: clamp(1.5rem, 3vw, 2.5rem);
    }

    .hero__overlay {
      position: static;
      display: block;
      order: -1;
      pointer-events: auto;
    }

    .hero__head {
      inline-size: auto;
      max-inline-size: 640px;
      margin-block-end: 1.5rem;
      /* Here the headline is the top of the page rather than an overlay on the
         map, so it cannot sit blank for most of a second while something below
         it fades up. It comes in with the map instead of over it. */
      animation-delay: 150ms;
    }

    .sec-head,
    .figure,
    .figure--wide {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feed li {
      grid-template-columns: 96px 1fr;
    }

    .feed .badge {
      grid-column: 2;
    }
  }

  @media (max-width: 620px) {
    .statband {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat {
      padding: 1rem;
      border-inline-start: 0;
      border-block-start: 1px solid var(--line-soft);
    }

    .stat:nth-child(-n + 2) {
      border-block-start: 0;
    }

    .cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .rung {
      grid-template-columns: 84px 1fr;
    }

    .rung__n {
      grid-column: 2;
    }

    .feed li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .matrix i {
      inline-size: 18px;
      block-size: 18px;
    }
  }
</style>
