---
/**
 * Datacentres: where frontier AI is built and run, site by site.
 *
 * The map and the list are one dataset, Epoch AI's AI Data Centers hub, which
 * follows the largest AI sites through satellite imagery, permits and company
 * statements. It is not a census. Epoch states what share of the world's AI
 * compute its sites hold, and the page prints that share beside every total so
 * a sum over the hub is never read as a sum over the world.
 *
 * Each marker carries two magnitudes of one quantity: the ring is the IT power
 * the site is being built to, the disc inside it the IT power operating now.
 * Area, not radius, is proportional to power, so a site four times the power
 * draws twice the diameter.
 *
 * The comparison with every datacentre, AI or not, comes from the Environmental
 * Disclosure Index, which records each figure as its publisher states it. Where
 * no publisher splits a total into AI and the rest, the row says so rather than
 * estimating it: the absence is part of what the page reports.
 *
 * Sorting the list costs no JavaScript. Each row carries its rank under every
 * ordering as a custom property, and a radio input points the rows' CSS `order`
 * at one of them. The list is one copy of the rows, not one per order, so a
 * row's id is unique and the map's link to it always lands. It is a grid with
 * ARIA table roles rather than a <table>, because a table row cannot take
 * `order`; the roles give assistive technology the same column structure a
 * table would. Its reading order is the DOM order, which is the sort by size.
 */
import Base from "../../layouts/Base.astro";
import Provenance from "../../components/Provenance.astro";
import StatTile from "../../components/StatTile.astro";
import ZoomMap, { type ZoomPoint } from "../../components/ZoomMap.astro";
import {
  assertRenderable,
  confirmed,
  freshness,
  getSource,
  oldestRetrieved,
  type Dataset,
} from "../../lib/sources";

import sitesFile from "../../../data/processed/ai-datacentres.json";
import sharesFile from "../../../data/processed/datacentre-shares.json";

interface SiteRecord {
  id: string;
  name: string;
  owner: string | null;
  users: string[];
  country: string | null;
  place: string | null;
  lat: number;
  lon: number;
  stage: "Operating" | "Under construction" | "Planned";
  first_power: string | null;
  power_mw: number | null;
  power_mw_planned: number | null;
  h100e: number | null;
  h100e_planned: number | null;
  capex_usd: number | null;
  chips: string | null;
  cooling: string | null;
  water: "evaporative" | "closed-loop" | "both" | null;
  power_source: string | null;
  use: string | null;
  category: string;
  url: string | null;
  source_id: string;
}

interface ShareRecord {
  measure: string;
  scope: string;
  period: string;
  total: number | null;
  ai: number | null;
  unit: string | null;
  ai_share_pct: number | null;
  ai_definition: string | null;
  statement: string;
  publisher: string;
  url: string | null;
  source_id: string;
}

const sites = confirmed(sitesFile as Dataset<SiteRecord>);
const shares = confirmed(sharesFile as Dataset<ShareRecord>);

const cites = [...new Set([...sites.sources, ...shares.sources])];
assertRenderable(...cites);

/* ---------------------------------------------------------------------------
   Formatting. Power is printed in watts with the prefix that keeps it under
   four digits, because a reader compares 300 MW with 1.2 GW more easily than
   300 with 1,200.
   --------------------------------------------------------------------------- */
const trim = (v: number) => (v >= 100 ? v.toFixed(0) : v >= 10 ? v.toFixed(0) : v.toFixed(1).replace(/\.0$/, ""));
const fmtPower = (mw: number | null) =>
  mw === null ? "not recorded" : mw >= 1000 ? `${trim(mw / 1000)} GW` : `${trim(mw)} MW`;
const fmtCount = (n: number) => n.toLocaleString("en-GB", { maximumFractionDigits: 0 });
const fmtH100e = (n: number | null) =>
  n === null ? "not recorded" : n >= 1e6 ? `${trim(n / 1e6)} million H100e` : `${fmtCount(Math.round(n / 1000) * 1000)} H100e`;
const fmtUsd = (n: number | null) =>
  n === null ? "not recorded" : n >= 1e9 ? `$${trim(n / 1e9)} billion` : `$${trim(n / 1e6)} million`;
const monthName = (ym: string | null) =>
  ym === null
    ? "not yet"
    : new Date(`${ym.slice(0, 7)}-01T00:00:00Z`).toLocaleDateString("en-GB", {
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      });
const listJoin = (items: string[]) =>
  items.length < 2 ? items.join("") : `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`;
const orUnknown = (v: string | null) => v ?? "not recorded";

const WATER: Record<string, string> = {
  evaporative: "Evaporative",
  "closed-loop": "Closed loop",
  both: "Both",
};

/* ---------------------------------------------------------------------------
   Totals over the hub.
   --------------------------------------------------------------------------- */
const records = sites.records;
const sum = (xs: Array<number | null>) => xs.reduce<number>((a, b) => a + (b ?? 0), 0);
const powerNow = sum(records.map((r) => r.power_mw));
const powerPlanned = sum(records.map((r) => r.power_mw_planned ?? r.power_mw));
const operating = records.filter((r) => r.stage === "Operating");
const building = records.filter((r) => r.stage !== "Operating");
const countries = [...new Set(records.map((r) => r.country).filter((c): c is string => !!c))];
const planned = (r: SiteRecord) => r.power_mw_planned ?? r.power_mw;
const bySize = [...records].sort(
  (a, b) => (planned(b) ?? -1) - (planned(a) ?? -1) || a.name.localeCompare(b.name),
);
const largest = bySize[0];
const largestNow = [...records].sort((a, b) => (b.power_mw ?? -1) - (a.power_mw ?? -1))[0];
const coolingKnown = records.filter((r) => r.water !== null);
const evaporative = records.filter((r) => r.water === "evaporative" || r.water === "both");
const useKnown = records.filter((r) => r.use !== null);
const sourceKnown = records.filter((r) => r.power_source !== null);

/* ---------------------------------------------------------------------------
   The map.
   --------------------------------------------------------------------------- */
/* Diameter from power, area-true: d = K * sqrt(MW). The floor keeps a small
   site hoverable, and is the one place the area rule bends, which the key
   says. */
const K = 0.62;
const FLOOR = 9;
const diameter = (mw: number | null) => (mw === null ? FLOOR : Math.max(FLOOR, K * Math.sqrt(mw)));
const STAGE_KEY: Record<SiteRecord["stage"], string> = {
  Operating: "operating",
  "Under construction": "building",
  Planned: "planned",
};

const points: ZoomPoint[] = bySize.map((r) => {
  const full = planned(r);
  const now = r.power_mw ?? 0;
  return {
    lon: r.lon,
    lat: r.lat,
    d: diameter(full),
    fill: full ? Math.sqrt(Math.min(now, full) / full) : 0,
    muted: full === null,
    tags: [STAGE_KEY[r.stage]],
    label: `${r.name}, ${r.stage.toLowerCase()}, ${fmtPower(r.power_mw)} now, ${fmtPower(full)} planned`,
    name: r.name,
    sub: [r.owner ? `Owned by ${r.owner}` : "Owner not recorded", r.place].filter(Boolean).join(", "),
    rows: [
      ["Status", r.stage],
      ["Operating since", monthName(r.first_power)],
      ["IT power", `${fmtPower(r.power_mw)} now, ${fmtPower(full)} planned`],
      ["Compute", r.h100e !== null || r.h100e_planned !== null ? `${fmtH100e(r.h100e)} now` : "not recorded"],
      ["Used by", r.users.length ? listJoin(r.users) : "not recorded"],
      ["Used for", orUnknown(r.use)],
      ["Power source", orUnknown(r.power_source)],
      ["Cooling", r.cooling ? `${r.cooling}${r.water ? `, ${WATER[r.water].toLowerCase()}` : ""}` : "not recorded"],
    ],
    href: `#site-${r.id}`,
    hrefLabel: "Row in the list",
  };
});

/* Sample rings for the key, drawn at the same scale as the markers. */
const KEY_SIZES = [100, 1000, 5000].map((mw) => ({ mw, d: diameter(mw) }));

/* ---------------------------------------------------------------------------
   The list, and its three orders.
   --------------------------------------------------------------------------- */
const rank = (sorted: SiteRecord[]) => new Map(sorted.map((r, i) => [r.id, i]));
const byOwner = [...records].sort(
  (a, b) => (a.owner ?? "￿").localeCompare(b.owner ?? "￿") || (planned(b) ?? -1) - (planned(a) ?? -1),
);
const CATEGORY_ORDER = [...new Set(records.map((r) => r.category))].sort();
const byCategory = [...records].sort(
  (a, b) =>
    CATEGORY_ORDER.indexOf(a.category) - CATEGORY_ORDER.indexOf(b.category) ||
    (planned(b) ?? -1) - (planned(a) ?? -1),
);
const sizeRank = rank(bySize);
const ownerRank = rank(byOwner);
const categoryRank = rank(byCategory);
const peak = Math.max(...records.map((r) => planned(r) ?? 0));

/* Group headings for the category order. Each heading takes the even slot just
   before its first row, so rows take odd slots: order is an integer, and two
   rows must never tie with a heading. */
const categoryHeads = CATEGORY_ORDER.map((category) => {
  const members = byCategory.filter((r) => r.category === category);
  return {
    category,
    count: members.length,
    power: sum(members.map(planned)),
    slot: 2 * (categoryRank.get(members[0].id) ?? 0),
  };
});

/* ---------------------------------------------------------------------------
   Shares of all datacentres.
   --------------------------------------------------------------------------- */
const shareRows = shares.records;

const retrievedAt = oldestRetrieved(sites, shares);
const checked = freshness(retrievedAt);

const epoch = getSource(sites.sources[0]);
const SITE_URL = "https://aisafetytracker.org";
const schema = {
  "@type": "Dataset",
  "@id": `${SITE_URL}/datacentres/#dataset`,
  name: "AI datacentres",
  description: sites.notes,
  url: `${SITE_URL}/datacentres/`,
  license: epoch.licence_url,
  isAccessibleForFree: true,
  isBasedOn: epoch.landing_page,
  creator: { "@type": "Organization", name: epoch.publisher, url: epoch.publisher_url },
  publisher: { "@id": `${SITE_URL}/#publisher` },
  dateModified: sites.generated,
  keywords: ["AI data centres", "datacentre power", "H100 equivalents", "datacentre cooling", "AI infrastructure map"],
  variableMeasured: [
    { "@type": "PropertyValue", name: "IT power", unitText: "MW", description: "IT power operating now and planned at completion." },
    { "@type": "PropertyValue", name: "compute", unitText: "H100 equivalents", description: "Compute capacity in H100 equivalents." },
  ],
};
---

<Base
  field="capability"
  title="AI datacentres"
  description="Every large AI datacentre Epoch AI tracks, on a map that pans and zooms: owner, users, IT power, compute, power source and cooling, and the share of all datacentres that AI accounts for."
  cites={cites}
  schema={schema}
>
  <section class="section section--open">
    <div class="wrap">
      <div class="masthead">
        <h1>Datacentres</h1>
        <p class="masthead__meta mono">
          {sites.count} sites
          <span aria-hidden="true">/</span>
          {countries.length} countries
          <span aria-hidden="true">/</span>
          {fmtPower(powerNow)} operating
          <span aria-hidden="true">/</span>
          <time datetime={retrievedAt} class={checked.stale ? "is-stale" : undefined}>retrieved {checked.label}</time>
        </p>
      </div>

      <div class="bento">
        <StatTile
          span={2}
          emphasis
          value={fmtPower(powerNow)}
          label="IT power operating across the sites tracked"
          detail={`${fmtPower(powerPlanned)} once every site is built to plan. ${operating.length} of ${sites.count} sites are operating; ${building.length} are under construction or planned.`}
          source={sites.sources}
          retrieved={sites.retrieved}
          note="Summed by this site over Epoch AI's per-site estimates. IT power excludes cooling and other overheads."
        />
        <StatTile
          span={2}
          value={fmtPower(planned(largest))}
          label={`Largest site at completion: ${largest.name}`}
          detail={`${largest.owner ? `Owned by ${largest.owner}` : "Owner not recorded"}${largest.users.length ? `, used by ${listJoin(largest.users)}` : ""}. ${fmtPower(largest.power_mw)} operating now.`}
          source={sites.sources}
          retrieved={sites.retrieved}
        />
        <StatTile
          span={2}
          value={fmtPower(largestNow.power_mw)}
          label={`Largest operating now: ${largestNow.name}`}
          detail={`${largestNow.owner ? `Owned by ${largestNow.owner}` : "Owner not recorded"}. ${fmtH100e(largestNow.h100e)}.`}
          source={sites.sources}
          retrieved={sites.retrieved}
        />
        <StatTile
          span={3}
          value={`${evaporative.length} of ${coolingKnown.length}`}
          label="Sites with a recorded cooling system that cool by evaporating water"
          detail={`Cooling towers evaporate water to reject heat; closed-loop and air-cooled systems do not. ${sites.count - coolingKnown.length} sites have no cooling system recorded.`}
          source={sites.sources}
          retrieved={sites.retrieved}
        />
        <StatTile
          span={3}
          value={`${useKnown.length} of ${sites.count}`}
          label="Sites with a recorded use, training or inference"
          detail={`${sourceKnown.length} of ${sites.count} have a recorded power source. Operators rarely state either for a single site.`}
          source={sites.sources}
          retrieved={sites.retrieved}
        />
      </div>
    </div>
  </section>

  <!-- MAP -->
  <section class="section section--sunk" id="map">
    <div class="wrap">
      <div class="section-head">
        <h2>Where they are</h2>
        <p>
          Every site in Epoch AI's AI Data Centers hub, sized by IT power. The ring is the power the
          site is being built to, the disc inside it the power operating now.
        </p>
      </div>

      <ZoomMap
        id="dcmap"
        points={points}
        label={`AI datacentres on a world map, ${sites.count} sites in ${countries.length} countries. The largest at completion is ${largest.name} at ${fmtPower(planned(largest))}.`}
        filters={[
          { key: "operating", label: `Operating (${operating.length})` },
          { key: "building", label: `Under construction (${records.filter((r) => r.stage === "Under construction").length})` },
          { key: "planned", label: `Planned (${records.filter((r) => r.stage === "Planned").length})` },
        ]}
      >
        <div class="key">
          {KEY_SIZES.map((k) => (
            <span class="key__item">
              <span class="dc-ring" style={`--d:${k.d.toFixed(1)}px`} aria-hidden="true" />
              {fmtPower(k.mw)}
            </span>
          ))}
          <span class="key__item">
            <span class="dc-ring dc-ring--part" style={`--d:${diameter(1000).toFixed(1)}px`} aria-hidden="true" />
            Disc: operating now
          </span>
          <span class="key__item">
            <span class="dc-ring dc-ring--muted" style={`--d:${FLOOR}px`} aria-hidden="true" />
            Power not recorded
          </span>
          <Provenance
            source={sites.sources}
            retrieved={sites.retrieved}
            note="Locations, owners, users and power are Epoch AI's. Marker area is proportional to IT power, with a floor so the smallest sites stay visible."
            label="map"
          />
        </div>
      </ZoomMap>

      <p class="caveat">
        {epoch.caveats} IT power is the power delivered to the computing equipment, before cooling
        and other overheads. A site marked planned has been announced or permitted; construction has
        not been observed.
      </p>
    </div>
  </section>

  <!-- SHARE -->
  <section class="section" id="share">
    <div class="wrap">
      <div class="section-head">
        <h2>AI against every datacentre</h2>
        <p>
          How much of all datacentre capacity AI accounts for, by count, electricity and water, as
          each publisher states it. A dash means no publisher separates AI from the total.
        </p>
      </div>

      <div class="scroll-x">
        <table class="grid-table">
          <caption class="visually-hidden">
            AI's share of all datacentres by number, electricity and water, with the total, the AI
            portion, the definition of AI used and the publisher.
          </caption>
          <thead>
            <tr>
              <th scope="col">Measure</th>
              <th scope="col">Scope</th>
              <th scope="col" class="ta-end">All datacentres</th>
              <th scope="col" class="ta-end">AI</th>
              <th scope="col" class="ta-end">AI share</th>
              <th scope="col" class="bar-col"><span class="visually-hidden">AI share, relative</span></th>
              <th scope="col" class="wrap-cell">What counts as AI</th>
            </tr>
          </thead>
          <tbody>
            {
              shareRows.map((s) => (
                <tr>
                  <th scope="row">{s.url ? <a href={s.url}>{s.measure}</a> : s.measure}</th>
                  <td class="muted-cell">{s.scope}, {s.period}</td>
                  <td class="ta-end num">{s.total !== null ? `${fmtCount(s.total)} ${s.unit ?? ""}`.trim() : "-"}</td>
                  <td class="ta-end num">{s.ai !== null ? `${fmtCount(s.ai)} ${s.unit ?? ""}`.trim() : "-"}</td>
                  <td class="ta-end num">{s.ai_share_pct !== null ? `${s.ai_share_pct}%` : "-"}</td>
                  <td class="bar-col">
                    {s.ai_share_pct !== null && (
                      <span class="bar" style={`--w:${s.ai_share_pct.toFixed(1)}%`} aria-hidden="true" />
                    )}
                  </td>
                  <td class="wrap-cell muted-cell">{s.ai_definition ?? s.statement}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="caveat">
        Each figure is the publisher's own and counts what its publisher defines as AI, which is not the
        same line in every row. The bar is drawn to 100%.
        <Provenance
          source={shares.sources}
          retrieved={shares.retrieved}
          note="Recorded by this site from each publisher's report, with the definition of AI it uses."
        />
      </p>
    </div>
  </section>

  <!-- LIST -->
  <section class="section section--sunk" id="list">
    <div class="wrap">
      <div class="section-head">
        <h2>Every site</h2>
        <p>
          The sites on the map, with owner, users, IT power and compute. Sorted by IT power at
          completion unless another order is chosen.
        </p>
      </div>

      <div class="dcl">
        <div class="dcl__sort" role="radiogroup" aria-label="Sort the list">
          <input type="radio" name="dcl-sort" id="dcl-size" class="dcl__radio" checked />
          <label for="dcl-size" class="chip">Size</label>
          <input type="radio" name="dcl-sort" id="dcl-owner" class="dcl__radio" />
          <label for="dcl-owner" class="chip">Owner</label>
          <input type="radio" name="dcl-sort" id="dcl-category" class="dcl__radio" />
          <label for="dcl-category" class="chip">Category</label>
        </div>

        <div class="scroll-x">
          <div class="dcl__rows" role="table" aria-label="AI datacentres, largest at completion first">
            <div class="dcl__head" role="row">
              <span role="columnheader">Site</span>
              <span role="columnheader">Owner</span>
              <span role="columnheader">Used by</span>
              <span role="columnheader">Category</span>
              <span role="columnheader">Status</span>
              <span role="columnheader" class="ta-end">IT power now</span>
              <span role="columnheader" class="ta-end">At completion</span>
              <span role="columnheader"><span class="visually-hidden">At completion, relative</span></span>
              <span role="columnheader" class="ta-end">Compute now</span>
              <span role="columnheader">Cooling</span>
            </div>
            {
              categoryHeads.map((h) => (
                <div class="dcl__group" style={`--o-cat:${h.slot}`} aria-hidden="true">
                  <span>{h.category}</span>
                  <span class="mono">{h.count} sites, {fmtPower(h.power)} at completion</span>
                </div>
              ))
            }
            {
              bySize.map((r) => (
                <div
                  class="dcl__row"
                  role="row"
                  id={`site-${r.id}`}
                  style={`--o-size:${2 * (sizeRank.get(r.id) ?? 0) + 1};--o-owner:${2 * (ownerRank.get(r.id) ?? 0) + 1};--o-cat:${2 * (categoryRank.get(r.id) ?? 0) + 1}`}
                >
                  <span class="dcl__name" role="rowheader">
                    {r.url ? <a href={r.url}>{r.name}</a> : r.name}
                    <span class="dcl__place">{[r.place, r.country].filter(Boolean).join(", ")}</span>
                  </span>
                  <span role="cell">{orUnknown(r.owner)}</span>
                  <span role="cell" class="muted-cell">{r.users.length ? listJoin(r.users) : "not recorded"}</span>
                  <span role="cell" class="muted-cell">{r.category}</span>
                  <span role="cell" class="muted-cell">{r.stage}</span>
                  <span role="cell" class="ta-end num">{r.power_mw !== null ? fmtPower(r.power_mw) : "-"}</span>
                  <span role="cell" class="ta-end num">{planned(r) !== null ? fmtPower(planned(r)) : "-"}</span>
                  <span role="cell" class="dcl__bar">
                    {planned(r) !== null && (
                      <span class="bar bar--thin" style={`--w:${(((planned(r) ?? 0) / peak) * 100).toFixed(1)}%`} aria-hidden="true" />
                    )}
                  </span>
                  <span role="cell" class="ta-end num">{r.h100e !== null ? fmtH100e(r.h100e).replace(" H100e", "") : "-"}</span>
                  <span role="cell" class="muted-cell">{r.cooling ?? "not recorded"}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <p class="caveat">
        Compute is in H100 equivalents, the number of Nvidia H100 chips with the same total
        performance. Category is this site's grouping of each site's owner.
        <Provenance
          source={sites.sources}
          retrieved={sites.retrieved}
          note="Every figure is Epoch AI's. Category is this site's classification of the owner."
        />
      </p>
    </div>
  </section>

  <!-- GAPS -->
  <section class="section" id="gaps">
    <div class="wrap">
      <div class="section-head">
        <h2>What this page cannot show</h2>
        <p>Questions a reader brings that no published source answers site by site.</p>
      </div>

      <ul class="cards">
        <li class="card">
          <span class="card__title">Every AI datacentre</span>
          <p>
            The hub follows the largest sites. Smaller AI clusters, and most sites outside the United
            States, are not yet on it.
          </p>
        </li>
        <li class="card">
          <span class="card__title">Training or inference</span>
          <p>Operators do not say which a site runs, and a site can move between the two.</p>
        </li>
        <li class="card">
          <span class="card__title">Renewable or fossil, per site</span>
          <p>
            Operators report clean-energy purchases for the whole company, not for a site. What grid
            and on-site generation serve a site is recorded where permits show it.
          </p>
          <span class="card__meta mono"><a href="/environment/#grid">Environment</a></span>
        </li>
        <li class="card">
          <span class="card__title">Water per site</span>
          <p>
            No operator publishes water use for a single AI site. The cooling system shows whether a site
            can evaporate water, not how much.
          </p>
        </li>
        <li class="card">
          <span class="card__title">Chinese sites</span>
          <p>Least documented in every public source, and so least represented here.</p>
        </li>
        <li class="card">
          <span class="card__title">Compute by country</span>
          <p>Epoch AI's wider census of GPU clusters, summed by country.</p>
          <span class="card__meta mono"><a href="/capability/">Capability</a></span>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Key rings, drawn with the same geometry as the map's markers and scaled
     with them: --zmap-ms is inherited from the map, which the key sits in. */
  .dc-ring {
    flex: none;
    inline-size: calc(var(--d) * var(--zmap-ms, 1));
    block-size: calc(var(--d) * var(--zmap-ms, 1));
    border: 1.5px solid var(--accent);
    border-radius: 50%;
  }

  .dc-ring--part {
    background: radial-gradient(closest-side, var(--accent) 55%, transparent calc(55% + 0.5px));
  }

  .dc-ring--muted {
    border-color: var(--muted-2);
    background: var(--muted-2);
  }

  /* The list. A grid, not a table, because a table row cannot take the CSS
     `order` the sort depends on. Each row is a subgrid of the list, so the
