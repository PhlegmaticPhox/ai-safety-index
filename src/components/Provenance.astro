---
/**
 * The click-through citation marker. Attach to any number, chart or table.
 *
 * Uses the native Popover API: no JavaScript, no focus-trap of our own, native
 * light-dismiss and Escape handling, and it lives in the top layer so it cannot
 * be clipped by an ancestor's overflow.
 *
 * Everything this emits is PHRASING content: spans only, no div/p/dl. That is
 * load-bearing, not fussiness. This marker sits inside <p>, and the HTML parser
 * auto-closes a paragraph when it meets a block-level tag, which silently hoists
 * the panel out of the paragraph and leaves an empty <p> behind. Layout comes
 * from CSS display instead. Keep it phrasing-only.
 */
import { Icon } from "astro-icon/components";
import { getSource, freshness } from "../lib/sources";
import { nextId } from "../lib/ids";

interface Props {
  /** One or more source_ids, as carried on the records being displayed. */
  source: string | string[];
  /** When this data was retrieved, from the dataset envelope. */
  retrieved?: string;
  /** What this specific figure measures, if narrower than the source as a whole. */
  note?: string;
  label?: string;
}

const { source, retrieved, note, label = "source" } = Astro.props;
const ids = Array.isArray(source) ? source : [source];
const entries = ids.map((id) => ({ id, ...getSource(id) }));
const age = retrieved ? freshness(retrieved) : null;
/* The calendar day beside the relative age. "5 days ago" is relative to a
   build date the panel never states, so on its own it cannot be recorded,
   quoted or compared with the publisher's own release date. */
const retrievedDay = retrieved ? retrieved.slice(0, 10) : null;

/* The popover and its CSS anchor need an id that is unique within the page.
 *
 * This used to be Math.random(), which made every build produce different HTML
 * from identical input. On a site whose whole argument is that you can check
 * where a number came from, that removed the one mechanical check available:
 * nobody, including us, could hash the deployed page and compare it to what the
 * repository builds. Two clean builds must be byte-identical.
 *
 * A module-scoped counter is enough. Astro renders a page in a single pass on
 * one thread, so the order components are reached is the order they appear in
 * the output, and that order is fixed by the source. The source ids stay in the
 * id because they make the markup readable when debugging; the counter is what
 * guarantees uniqueness when the same source is cited twice on one page.
 */
const popoverId = `prov-${ids.join("-")}-${nextId()}`;
const anchorName = `--${popoverId}`;
---

<span class="prov">
  <button
    type="button"
    popovertarget={popoverId}
    class="prov__trigger"
    style={`anchor-name:${anchorName}`}
    aria-label={`Show source and licence for this ${label}`}
  >
    <Icon name="ph:info" width="13" height="13" aria-hidden="true" />
  </button>

  <span popover id={popoverId} class="prov__panel" style={`position-anchor:${anchorName}`}>
    {note && <span class="prov__note">{note}</span>}

    {
      entries.map((entry) => (
        <span class="prov__source">
          <a href={entry.landing_page} class="prov__name">
            {entry.name}
          </a>
          <span class="prov__publisher">{entry.publisher}</span>

          <span class="prov__meta">
            <span class="prov__key">Licence</span>
            <span class="prov__val">
              <a href={entry.licence_url}>{entry.licence}</a>
            </span>
            {entry.cadence && (
              <>
                <span class="prov__key">Updated</span>
                <span class="prov__val">{entry.cadence}</span>
              </>
            )}
            {age && (
              <>
                <span class="prov__key">Retrieved</span>
                <span class:list={["prov__val", age.stale && "is-stale"]}>
                  <time datetime={retrieved}>{retrievedDay}</time>, {age.label}
                  {age.stale && " (may be out of date)"}
                </span>
              </>
            )}
          </span>

          {entry.caveats && <span class="prov__caveat">{entry.caveats}</span>}
        </span>
      ))
    }
  </span>
</span>

<style>
  .prov {
    display: inline;
  }

  .prov__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 24px hit area on an 11px glyph, without disturbing the text baseline. */
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin-inline-start: 0.05em;
    margin-block: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--muted);
    cursor: help;
    vertical-align: baseline;
    transition: color 0.18s var(--ease), background-color 0.18s var(--ease);
  }

  .prov__trigger:hover,
  .prov__trigger:focus-visible {
    color: var(--accent);
    background: var(--accent-wash);
  }

  .prov__panel:popover-open {
    display: block;
  }

  .prov__panel {
    inline-size: min(28rem, calc(100vw - 2rem));
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--surface-2);
    color: var(--ink);
    box-shadow: 0 16px 44px rgb(0 0 0 / 0.55);
    font-family: var(--f-sans);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.55;
    text-align: start;
    letter-spacing: 0;
    /* Attach to the trigger where supported; falls back to the UA's centred
       position otherwise, which stays perfectly usable. */
    position-area: block-end span-inline-end;
    position-try-fallbacks: block-start span-inline-end, block-end span-inline-start,
      block-start span-inline-start;
    margin: 0.35rem 0 0;
  }

  .prov__note {
    display: block;
    margin-block-end: 0.7rem;
    padding-block-end: 0.7rem;
    border-block-end: 1px solid var(--line);
  }

  .prov__source {
    display: block;
  }

  .prov__source + .prov__source {
    margin-block-start: 0.9rem;
    padding-block-start: 0.9rem;
    border-block-start: 1px solid var(--line);
  }

  .prov__name {
    font-weight: 600;
  }

  .prov__publisher {
    display: block;
    margin-block: 0.1rem 0.55rem;
    color: var(--muted);
  }

  .prov__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.75rem;
    margin-block-end: 0.55rem;
  }

  .prov__key {
    color: var(--muted);
  }

  .is-stale {
    color: var(--warn);
  }

  .prov__caveat {
    display: block;
    padding-block-start: 0.55rem;
    border-block-start: 1px dashed var(--line);
    color: var(--muted);
  }
</style>
