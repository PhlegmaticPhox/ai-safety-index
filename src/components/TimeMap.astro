---
/**
 * A choropleth you can step through time on, with no JavaScript.
 *
 * The obvious implementation renders one SVG per period and shows the selected
 * one. That ships the world's coastlines three times, which is about 120KB of
 * duplicated path data for a map whose geometry never changes.
 *
 * Instead the geometry is rendered once, and each country carries one custom
 * property per period holding the fill it should have then. A radio input drives
 * a CSS rule that repoints every shape's fill at a different property. Switching
 * period is one style recalculation and no network, no script and no reflow of
 * the path data.
 *
 * The trade-off, stated because it is a real one: the native <title> tooltip
 * cannot change with the period, so it names the country and the latest value
 * only. The per-period numbers are in the table the map links to.
 */
import { projectWorld } from "../lib/geo";

export interface TimeMapDatum {
  /** ISO alpha-3. */
  code: string;
  /** One fill per period, in the same order as `periods`. */
  fills: string[];
  /** Native tooltip text. */
  title: string;
  /** Where clicking the shape goes. */
  href?: string;
}

interface Props {
  /** Period labels, oldest first. */
  periods: string[];
  data: TimeMapDatum[];
  /** Legend swatches, low to high. */
  legend: Array<{ label: string; colour: string }>;
  /** Accessible description. */
  label: string;
  /** Which period is selected on load. Defaults to the most recent. */
  initial?: number;
  width?: number;
  places?: number;
  /** Unique per page: two maps on one page would otherwise share radio names. */
  id?: string;
  /**
   * Whether to draw the period scrubber.
   *
   * Off, the map shows `initial` and nothing else: no radios are rendered at
   * all, so there are no controls left in the accessibility tree with nothing
   * visible to operate them, and the fill is pinned by a static rule instead of
   * by :checked. Used where the map is the ground of a hero rather than the
   * figure being read.
   */
  scrub?: boolean;
  /** Multiplies the stroke widths, so a wider viewBox keeps the same rendered
      hairline. The var(--hair, 1) fallback in the rules is mandatory: an
      unresolvable var() makes the whole declaration invalid, which would
      render every hairline at the initial stroke-width of 1 at full scale. */
  stroke?: number;
}

const {
  periods,
  data,
  legend,
  label,
  initial = periods.length - 1,
  width = 900,
  places = 1,
  stroke = 1,
  id = "tm",
  scrub = true,
} = Astro.props;

for (const datum of data) {
  if (datum.fills.length !== periods.length) {
    throw new Error(
      `TimeMap: ${datum.code} has ${datum.fills.length} fills for ${periods.length} ` +
        `periods. A short array would render the last periods transparent, which reads ` +
        `as "no data" rather than as a bug.`,
    );
  }
}

/* Period labels are interpolated into a raw <style> block further down, via
   set:html. That is unescaped HTML insertion, so a label containing "</style>"
   would close the element and everything after it would be parsed as markup.
   Stripping quotes is not enough; nothing about CSS string escaping helps once
   the element itself has been terminated.

   The labels that reach this component today happen to be safe, because
   etl/fetch_microsoft_diffusion.py matches its column headers against a regex
   and re-emits them as "2026-Q1". But that is a constraint in a different file
   that this component knows nothing about, and the second caller - a second map,
   or an upstream header format that loosens - would silently reopen it.

   So the sink guards itself, and it fails the build rather than quietly
   rewriting a label. A sanitiser that strips the dangerous characters would
   render "2026-Q1</style>" as "2026-Q1style" and carry on, which hides the fact
   that something upstream is wrong. A period label is a short machine-generated
   token; if one ever contains anything else, that is a bug to see, not to mop up. */
const PERIOD_LABEL = /^[A-Za-z0-9][A-Za-z0-9 _-]{0,31}$/;

/* `id` is interpolated into the same raw block, as a selector rather than a
   string, so it needs the same treatment. Narrower, because it also has to be a
   valid HTML id and a valid CSS identifier. */
if (!/^[A-Za-z][A-Za-z0-9_-]{0,31}$/.test(id)) {
  throw new Error(
    `TimeMap: id ${JSON.stringify(id)} is not a plain identifier. It becomes both ` +
      `an HTML id and a CSS selector in a raw <style> block.`,
  );
}

for (const period of periods) {
  if (typeof period !== "string" || !PERIOD_LABEL.test(period)) {
    throw new Error(
      `TimeMap: period label ${JSON.stringify(period)} is not a plain label. ` +
        `Labels go into a raw <style> block, so they are restricted to letters, ` +
        `digits, spaces, hyphens and underscores (max 32 chars). Fix the data or ` +
        `the caller rather than widening this pattern.`,
    );
  }
}

const world = projectWorld(width, places);
const byCode = new Map(data.map((d) => [d.code, d]));
const covered = world.shapes.filter((s) => s.code && byCode.has(s.code)).length;

/* One rule per period, emitted inline because the selector index is data rather
   than something a static stylesheet can know.

   The fill is read through a fallback, not a bare var(). A country with no data
   carries no --vN at all, and an unresolvable var() makes the whole declaration
   invalid at computed-value time, at which point `fill` falls back to its
   initial value, which is black. Every unshaded country would have rendered
   solid black with nothing in the markup looking wrong. The selector is also
   narrowed to shapes inside a link, which are exactly the ones that have data. */

/* Distance along the rail, as a percentage, of the i-th tick. Ticks sit at the
   centre of equal-width steps, so the rail spans centre to centre and the fill
   is a straight fraction of it. A single period has no span, so it gets 0 and
   the rail is hidden below. */
const span = periods.length > 1 ? periods.length - 1 : 1;

/* With no scrubber there is nothing to check, so the selected period is pinned
   by one static rule keyed off the root instead of by :checked. */
const rules = !scrub
  ? `#${id} .tm__now::after { content: "${periods[initial]}"; }`
  : periods
  .map(
    (_, i) => `#${id}-${i}:checked ~ .tm__figure .tm__link .tm__shape { fill: var(--v${i}, var(--surface-2)); }
#${id}-${i}:checked ~ .tm__scrub .tm__step:nth-of-type(${i + 1}) .tm__label { color: var(--ink); }
#${id}-${i}:checked ~ .tm__scrub .tm__step:nth-of-type(${i + 1}) .tm__dot { background: var(--accent); border-color: var(--accent); transform: scale(1.5); }
#${id}-${i}:checked ~ .tm__scrub .tm__fill { inline-size: ${((i / span) * 100).toFixed(4)}%; }
#${id}-${i}:focus-visible ~ .tm__scrub .tm__step:nth-of-type(${i + 1}) .tm__dot { outline: 2px solid var(--accent); outline-offset: 3px; }
#${id}-${i}:checked ~ .tm__figure .tm__now::after { content: "${periods[i]}"; }`,
  )
  .join("\n");
---

<div class="tm" id={id}>
  {
    scrub &&
      periods.map((period, i) => (
        <input
          class="tm__radio"
          type="radio"
          name={id}
          id={`${id}-${i}`}
          checked={i === initial}
          aria-label={`Show ${period}`}
        />
      ))
  }

  {scrub && (
  <div class="tm__scrub" role="group" aria-label="Reporting period">
    <div class="tm__track" style={`--n:${periods.length}`}>
      {periods.length > 1 && (
        <span class="tm__rail" aria-hidden="true">
          <span class="tm__fill" />
        </span>
      )}
      {
        periods.map((period, i) => (
          <label class="tm__step" for={`${id}-${i}`}>
            <span class="tm__dot" aria-hidden="true" />
            <span class="tm__label mono">{period}</span>
          </label>
        ))
      }
    </div>
  </div>
  )}

  <figure class="tm__figure">
    <!-- The plot box exists so an overlay can share the map's exact geometry.
         Anything in the "overlay" slot is positioned against this box, which is
         the SVG and nothing else, so a viewBox coordinate and a percentage
         offset refer to the same point at every width. -->
    <div class="tm__plot">
    <svg
      viewBox={`0 0 ${world.width} ${world.height}`}
      role="img"
      aria-label={`${label}${scrub ? "" : `, ${periods[initial]}`}. ${covered} of ${world.shapes.length} countries have data; the rest are unshaded.`}
      class="tm__svg"
      style={`--hair:${stroke}`}
    >
      <path d={world.sphere} class="tm__sphere"></path>
      {
        world.shapes.map((shape) => {
          const datum = shape.code ? byCode.get(shape.code) : undefined;
          if (!datum) {
            return (
              <path d={shape.d} class="tm__shape tm__shape--empty">
                <title>{`${shape.name}: not in this dataset`}</title>
              </path>
            );
          }
          const vars = scrub
            ? datum.fills.map((fill, i) => `--v${i}:${fill}`).join(";")
            : `fill:${datum.fills[initial]}`;
          return (
            <a href={datum.href ?? undefined} class="tm__link">
              <path d={shape.d} class="tm__shape" style={vars}>
                <title>{datum.title}</title>
              </path>
            </a>
          );
        })
      }
    </svg>
      <slot name="overlay" />
    </div>

    <figcaption class="key">
      <span class="tm__now mono" aria-hidden="true"></span>
      {
        legend.map((entry) => (
          <span class="key__item">
            <span class="key__swatch" style={`--swatch:${entry.colour}`} />
            {entry.label}
          </span>
        ))
      }
      <span class="key__item">
        <span class="key__swatch" style="--swatch:var(--surface-2)" />
        no data
      </span>
    </figcaption>
  </figure>
</div>

<style set:html={rules} is:inline></style>

<style>
  .tm {
    display: flow-root;
  }

  /* Off-screen rather than display:none, so the radios stay focusable and the
     period stepper is operable from the keyboard. */
  .tm__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* The period scrubber.

     A track with one tick per reporting period rather than a row of pills. It
     is still radio-driven, so it costs no JavaScript and keeps arrow-key
     operation; what changed is that it reads as one axis with a position on it
     instead of a set of separate buttons.

     It scrolls rather than wraps. Each step holds a floor width, so once there
     are more periods than fit, the track overflows and the scrollbar becomes
     the control. Three periods fit on a phone today and it does not scroll. */
  .tm__scrub {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    margin-block-end: 0.9rem;
    padding-block-end: 0.15rem;
  }

  .tm__track {
    position: relative;
    display: flex;
    min-inline-size: 100%;
    padding-block-start: 0.45rem;
  }

  /* Spans tick centre to tick centre. Steps are equal width, so the first and
     last centres sit half a step in from each end. */
  .tm__rail {
    position: absolute;
    inset-block-start: 0.7rem;
    inset-inline: calc(50% / var(--n));
    block-size: 2px;
    border-radius: var(--r-mark);
    background: var(--line);
  }

  .tm__fill {
    display: block;
    block-size: 100%;
    inline-size: 0;
    border-radius: inherit;
    background: var(--accent);
    transition: inline-size 0.28s var(--ease);
  }

  .tm__step {
    position: relative;
    z-index: 1;
    flex: 1 0 5.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding-block-end: 0.15rem;
    cursor: pointer;
  }

  .tm__dot {
    inline-size: 9px;
    block-size: 9px;
    border: 2px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
    transition: background-color 0.18s var(--ease), border-color 0.18s var(--ease),
      transform 0.18s var(--ease);
  }

  .tm__label {
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
    transition: color 0.18s var(--ease);
  }

  .tm__step:hover .tm__dot {
    border-color: var(--accent-line);
  }

  .tm__step:hover .tm__label {
    color: var(--ink);
  }

  /* Keyboard focus lands on the off-screen input, so the ring is drawn on the
     matching tick by the generated rules above. */

  @media (prefers-reduced-motion: reduce) {
    .tm__fill,
    .tm__dot {
      transition: none;
    }
  }

  .tm__figure {
    margin: 0;
  }

  /* Establishes the containing block for the overlay slot. */
  .tm__plot {
    position: relative;
  }

  /* The sphere's outline runs about a tenth of its height past the bottom of the
     viewBox, and .tm__svg below does not clip it. .tm__plot is positioned, so
     everything painted inside it lands above later in-flow content whatever the
     source order says: the legend was drawn first and the map's own bottom edge
     over the top of it, hiding every swatch the sphere still covered at that
     height. Positioning the caption puts it back in the same layer, where tree
     order decides and it comes last. */
  .tm__figure .key {
    position: relative;
  }

  .tm__svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .tm__sphere {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: calc(1 * var(--hair, 1));
  }

  .tm__shape {
    fill: var(--surface-2);
    stroke: var(--bg);
    stroke-width: calc(0.4 * var(--hair, 1));
    transition: fill 0.35s var(--ease);
  }

  .tm__shape--empty {
    fill: var(--surface-2);
  }

  .tm__link:hover .tm__shape,
  .tm__link:focus-visible .tm__shape {
    stroke: var(--ink);
    stroke-width: calc(0.9 * var(--hair, 1));
  }

  .tm__link:focus-visible {
    outline: none;
  }

  .tm__now {
    font-weight: 500;
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .tm__shape {
      transition: none;
    }
  }
</style>
