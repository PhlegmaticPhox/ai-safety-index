---
/**
 * A ranked table of label, value and magnitude bar, showing the top rows and
 * putting the tail behind a native <details>.
 *
 * Four pages had grown their own copy of this, and three of them printed every
 * row of a hundred-row ranking, which buries the figure the section is about
 * under ninety rows nobody reads. The rule here: the visible rows must be enough
 * to read the chart, and the tail is the full data rather than the point.
 *
 * No JavaScript. <details> is keyboard accessible, and browsers that search
 * hidden text still find collapsed rows with Ctrl+F.
 */
export interface BarRow {
  label: string;
  /** The number the bar is scaled from. */
  value: number;
  /** What to print, if it is not just the value. */
  display?: string;
  /** Optional second column, for a count or a share. */
  meta?: string;
  /** Makes the label a link. */
  href?: string;
  /** Marks this row as the reader's own point of reference. */
  highlight?: boolean;
}

interface Props {
  rows: BarRow[];
  /** Column heading for the label column. */
  head: string;
  /** Column heading for the value column. */
  valueHead: string;
  /** Optional heading for the meta column. Omit and the column is not drawn. */
  metaHead?: string;
  /** How many rows to show before the disclosure. */
  top?: number;
  /** Scale bars against this. Defaults to the largest value present. */
  max?: number;
  /** Extra class on the bar, for the governance hue. */
  barClass?: string;
  /** Screen-reader description of the whole table. */
  caption: string;
}

const {
  rows,
  head,
  valueHead,
  metaHead,
  top = 10,
  max,
  barClass = "",
  caption,
} = Astro.props;

const peak = max ?? Math.max(...rows.map((r) => r.value), 0);
const width = (value: number) => (peak > 0 ? ((value / peak) * 100).toFixed(1) : "0");
const visible = rows.slice(0, top);
const hidden = rows.slice(top);
---

<div class="scroll-x">
  <table class="bars bars--fixed">
    <colgroup>
      <col />
      <col class="col-v" />
      {metaHead && <col class="col-m" />}
      <col class="col-b" />
    </colgroup>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{head}</th>
        <th scope="col" class="ta-end">{valueHead}</th>
        {metaHead && <th scope="col" class="ta-end">{metaHead}</th>}
        <th scope="col" class="bar-col">
          <span class="visually-hidden">Relative magnitude</span>
        </th>
      </tr>
    </thead>
    <tbody>
      {
        visible.map((row) => (
          <tr class:list={[row.highlight && "is-mine"]}>
            <th scope="row">{row.href ? <a href={row.href}>{row.label}</a> : row.label}</th>
            <td class="ta-end num">{row.display ?? row.value}</td>
            {metaHead && <td class="ta-end num muted-cell">{row.meta}</td>}
            <td class="bar-col">
              <span
                class:list={["bar", barClass]}
                style={`--w:${width(row.value)}%`}
                aria-hidden="true"
              />
            </td>
          </tr>
        ))
      }
    </tbody>

    {
      hidden.length > 0 && (
        <tbody class="bars__tail">
          <tr>
            <td colspan={metaHead ? 4 : 3} class="bars__disclose">
              <details class="reveal">
                <summary>
                  Show the remaining <span class="reveal__count">{hidden.length}</span>
                </summary>
                <div class="reveal__body">
                  <table class="bars bars--fixed">
                    <colgroup>
                      <col />
                      <col class="col-v" />
                      {metaHead && <col class="col-m" />}
                      <col class="col-b" />
                    </colgroup>
                    <caption class="visually-hidden">
                      {caption} Rows {top + 1} to {rows.length}.
                    </caption>
                    <tbody>
                      {hidden.map((row) => (
                        <tr class:list={[row.highlight && "is-mine"]}>
                          <th scope="row">
                            {row.href ? <a href={row.href}>{row.label}</a> : row.label}
                          </th>
                          <td class="ta-end num">{row.display ?? row.value}</td>
                          {metaHead && <td class="ta-end num muted-cell">{row.meta}</td>}
                          <td class="bar-col">
                            <span
                              class:list={["bar", barClass]}
                              style={`--w:${width(row.value)}%`}
                              aria-hidden="true"
                            />
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            </td>
          </tr>
        </tbody>
      )
    }
  </table>
</div>

<style>
  /* Fixed layout with an explicit colgroup, on both tables.
     The tail is a second table inside <details>, because a <details> cannot be a
     child of <tbody>, and two tables size their columns independently: with auto
     layout the hidden rows laid out their own way and every bar in the tail
     started a hundred pixels right of the bars above it. Identical colgroups
     plus table-layout:fixed makes the two agree. */
  .bars--fixed {
    table-layout: fixed;
  }

  .col-v {
    inline-size: 7.5rem;
  }

  .col-m {
    inline-size: 8.5rem;
  }

  .col-b {
    inline-size: 46%;
  }

  /* Fixed layout cannot widen for a long name, so the label wraps rather than
     spilling over the number beside it. */
  .bars--fixed th[scope="row"] {
    white-space: normal;
    padding-inline-end: 0.75rem;
  }

  .bars__disclose {
    padding: 0;
  }

  .bars__tail .reveal {
    margin-block-start: 0;
  }

  .bars__tail table {
    margin-block-start: -0.2rem;
  }

  .is-mine th[scope="row"] {
    color: var(--accent-ink);
  }

  /* Phone widths. The desktop columns (7.5rem, 8.5rem and 46%) add up to more
     than a 358px table, and fixed layout does not widen, so the label column was
     squeezed to nothing: "Netherlands" printed over "43.5%" on the homepage, and
     the nowrap headers ran into each other. The numbers need about 5rem each and
     the bar only has to read as a comparison. Placed after the rules it
     overrides, because at equal specificity the later rule wins. */
  @media (max-width: 640px) {
    .col-v {
      inline-size: 5.5rem;
    }

    .col-m {
      inline-size: 5rem;
    }

    .col-b {
      inline-size: 24%;
    }

    .bars--fixed thead th {
      white-space: normal;
      vertical-align: bottom;
    }
  }
</style>
