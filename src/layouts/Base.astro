---
import "../styles/global.css";
import { attributionsFor } from "../lib/sources";

/**
 * The two font files a reader of this site actually downloads.
 *
 * Geist ships eleven woff2 files and the build emits all eleven, but the
 * @font-face rules are unicode-range gated, so a Latin page pulls exactly these
 * two: 51KB of the 143KB on disk. The other nine (Cyrillic, Greek, Vietnamese,
 * symbols) are never requested and must not be preloaded, which is why these are
 * named one by one rather than globbed.
 *
 * Preloaded because the browser cannot otherwise know they exist until it has
 * fetched and parsed the stylesheet, which makes the critical path
 * HTML -> CSS -> font, three serial round trips on a phone. The preload starts
 * the font in parallel with the CSS. font-display: swap means text was never
 * blocked on this; what it removes is the flash of fallback text reflowing.
 *
 * Imported with ?url rather than written out, because the filenames are
 * content-hashed and change whenever the font package is updated. A hardcoded
 * path would 404 silently after the next upgrade: a preload that misses costs a
 * wasted request and warns in the console, and nothing on the page looks wrong.
 */
import geistSans from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

const SITE = "AI Safety Tracker";

interface Props {
  /**
   * The page's own name, and nothing else.
   *
   * For a page in the nav this is exactly its nav label, so the browser tab, the
   * bookmark, the search result and the menu all say the same word. The site
   * name is appended here rather than written out per page, which is what stopped
   * three pages drifting into three different title formats.
   */
  title: string;
  description: string;
  /** source_ids cited anywhere on this page, rendered as the attribution block. */
  cites?: string[];
  /** Set on the homepage, where "AI Safety Tracker | AI Safety Tracker" is absurd. */
  root?: boolean;
}

const { title, description, cites = [], root = false } = Astro.props;
const documentTitle = root ? `${SITE}: cited data on AI capability, governance and safety` : `${title} | ${SITE}`;
const attributions = attributionsFor(...cites);
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

/* Nav order runs outward from the models themselves: what they can do, what they
   cost, whether anyone can steer them, who uses them, where, under what law,
   what changed this week, and where every number came from. */
const nav = [
  { href: "/progress/", label: "Progress" },
  { href: "/capability/", label: "Capability" },
  { href: "/alignment/", label: "Alignment" },
  { href: "/adoption/", label: "Adoption" },
  { href: "/map/", label: "Map" },
  { href: "/policy/", label: "Policy" },
  { href: "/news/", label: "News" },
  { href: "/sources/", label: "Sources" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={geistSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="mask-icon" href="/favicon.svg" color="#f2a950" />

    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <!-- Summary card, not summary_large_image: this site has no images by design,
         and claiming a large image card produces an empty grey box. -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#141924" />
    <meta name="color-scheme" content="dark" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="head">
      <div class="wrap head__inner">
        <a href="/" class="brand">
          <span class="brand__mark" aria-hidden="true"></span>
          AI Safety Tracker
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        {
          attributions.length > 0 && (
            <section class="attribution">
              <h2>Data sources on this page</h2>
              <ul>
                {attributions.map((source) => (
                  <li>
                    <a href={source.landing_page}>{source.name}</a>
                    <span class="attribution__pub">{source.publisher}</span>
                    <a href={source.licence_url} class="attribution__lic">
                      {source.licence}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="foot__end">
          <p>
            Figures are reproduced from the sources named above under their respective licences
            and remain theirs. Our own code, indexes and written explainers are
            <a href="https://opensource.org/licenses/MIT">MIT</a>. Errors are ours.
            <a href="/corrections/">Report one</a> and it gets fixed and listed rather than
            quietly patched.
          </p>
          <p class="foot__meta">
            <span>{year} AI Safety Tracker</span>
            <a href="/about/">About</a>
            <a href="/methodology/">Methodology</a>
            <a href="/sources/">All sources</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/corrections/">Corrections</a>
          </p>
        </div>
      </div>
    </footer>

    <style>
      .head {
        position: sticky;
        inset-block-start: 0;
        z-index: 20;
        border-block-end: 1px solid var(--line);
        background: rgb(20 25 36 / 0.86);
        backdrop-filter: blur(12px);
      }

      /* Nav stays on one line and within the height cap. */
      .head__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        block-size: 52px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--ink);
        font-weight: 600;
        font-size: 0.9375rem;
        letter-spacing: -0.01em;
        text-decoration: none;
        white-space: nowrap;
      }

      /* The header mark is the favicon reduced to its one load-bearing element:
         a filled cell sitting above the grid line. Same idea, no detail that
         would be lost at this size. */
      .brand__mark {
        position: relative;
        inline-size: 14px;
        block-size: 14px;
        border-radius: var(--r-mark);
        border: 1px solid var(--line);
        background: linear-gradient(var(--accent) 0 55%, transparent 55%) right / 45% 100%
          no-repeat;
      }

      .head nav ul {
        display: flex;
        gap: 1.05rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .head nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.8125rem;
        white-space: nowrap;
        transition: color 0.18s var(--ease);
      }

      .head nav a:hover,
      .head nav a[aria-current="page"] {
        color: var(--ink);
      }

      @media (max-width: 640px) {
        .head__inner {
          block-size: auto;
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
          padding-block: 0.75rem;
        }

        .head nav ul {
          gap: 1.1rem;
          flex-wrap: wrap;
        }
      }

      .foot {
        margin-block-start: 2rem;
        padding-block: 1.5rem 2rem;
        border-block-start: 1px solid var(--line);
        background: var(--surface);
        font-size: 0.8125rem;
        color: var(--muted);
      }

      .attribution h2 {
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-block-end: 0.85rem;
      }

      .attribution ul {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
        gap: 0.2rem 2rem;
        margin: 0 0 1.25rem;
        padding: 0;
        list-style: none;
      }

      .attribution li {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding-block: 0.3rem;
        border-block-end: 1px solid var(--line-soft);
      }

      .attribution__pub {
        flex: 1;
        min-inline-size: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .attribution__lic {
        font-family: var(--f-mono);
        font-size: 0.6875rem;
        color: var(--muted);
        white-space: nowrap;
      }

      .foot__end p {
        max-inline-size: 68ch;
        line-height: 1.65;
      }

      .foot__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.1rem;
        margin-block-start: 0.9rem;
        padding-block-start: 0.9rem;
        border-block-start: 1px solid var(--line);
      }
    </style>
  </body>
</html>
