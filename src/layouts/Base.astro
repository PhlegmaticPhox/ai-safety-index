---
import "../styles/global.css";
import { attributionsFor } from "../lib/sources";

interface Props {
  title: string;
  description: string;
  /** source_ids cited anywhere on this page, rendered as the attribution block. */
  cites?: string[];
}

const { title, description, cites = [] } = Astro.props;
const attributions = attributionsFor(...cites);
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

const nav = [
  { href: "/capability/", label: "Capability" },
  { href: "/map/", label: "Map" },
  { href: "/news/", label: "News" },
  { href: "/adoption/", label: "Adoption" },
  { href: "/policy/", label: "Policy" },
  { href: "/sources/", label: "Sources" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#141924" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Not launched yet. Remove when the site goes live on its own domain. -->
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="head">
      <div class="wrap head__inner">
        <a href="/" class="brand">
          <span class="brand__mark" aria-hidden="true"></span>
          AI Safety Index
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={Astro.url.pathname.startsWith(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        {
          attributions.length > 0 && (
            <section class="attribution">
              <h2>Data sources on this page</h2>
              <ul>
                {attributions.map((source) => (
                  <li>
                    <a href={source.landing_page}>{source.name}</a>
                    <span class="attribution__pub">{source.publisher}</span>
                    <a href={source.licence_url} class="attribution__lic">
                      {source.licence}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="foot__end">
          <p>
            Figures are reproduced from the sources named above under their respective licences
            and remain theirs. Site code, written explainers and the Governance Readiness Index
            are <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Errors are
            ours. <a href="/corrections/">Report one</a> and it gets logged publicly rather than
            quietly patched.
          </p>
          <p class="foot__meta">
            <span>{year} AI Safety Index</span>
            <a href="/about/">About</a>
            <a href="/methodology/">Methodology</a>
            <a href="/sources/">All sources</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="https://github.com/PhlegmaticPhox/ai-safety-index">Repository</a>
          </p>
        </div>
      </div>
    </footer>

    <style>
      .head {
        position: sticky;
        inset-block-start: 0;
        z-index: 20;
        border-block-end: 1px solid var(--line);
        background: rgb(20 25 36 / 0.86);
        backdrop-filter: blur(12px);
      }

      /* Nav stays on one line and within the height cap. */
      .head__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        block-size: 64px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--ink);
        font-weight: 600;
        font-size: 0.9375rem;
        letter-spacing: -0.01em;
        text-decoration: none;
        white-space: nowrap;
      }

      .brand__mark {
        inline-size: 9px;
        block-size: 9px;
        border-radius: var(--r-mark);
        background: var(--accent);
      }

      .head nav ul {
        display: flex;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .head nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.875rem;
        white-space: nowrap;
        transition: color 0.18s var(--ease);
      }

      .head nav a:hover,
      .head nav a[aria-current="page"] {
        color: var(--ink);
      }

      @media (max-width: 640px) {
        .head__inner {
          block-size: auto;
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
          padding-block: 0.75rem;
        }

        .head nav ul {
          gap: 1.1rem;
          flex-wrap: wrap;
        }
      }

      .foot {
        margin-block-start: 4rem;
        padding-block: 2.5rem 3.5rem;
        border-block-start: 1px solid var(--line);
        background: var(--surface);
        font-size: 0.8125rem;
        color: var(--muted);
      }

      .attribution h2 {
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-block-end: 0.85rem;
      }

      .attribution ul {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
        gap: 0.4rem 2rem;
        margin: 0 0 2rem;
        padding: 0;
        list-style: none;
      }

      .attribution li {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding-block: 0.3rem;
        border-block-end: 1px solid var(--line-soft);
      }

      .attribution__pub {
        flex: 1;
        min-inline-size: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .attribution__lic {
        font-family: var(--f-mono);
        font-size: 0.6875rem;
        color: var(--muted);
        white-space: nowrap;
      }

      .foot__end p {
        max-inline-size: 68ch;
        line-height: 1.65;
      }

      .foot__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        margin-block-start: 1.25rem;
        padding-block-start: 1.25rem;
        border-block-start: 1px solid var(--line);
      }
    </style>
  </body>
</html>
