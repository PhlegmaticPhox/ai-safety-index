---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import { attributionsFor } from "../lib/sources";

/**
 * The two font files a reader of this site actually downloads.
 *
 * Geist ships eleven woff2 files and the build emits all eleven, but the
 * @font-face rules are unicode-range gated, so a Latin page pulls exactly these
 * two: 51KB of the 143KB on disk. The other nine (Cyrillic, Greek, Vietnamese,
 * symbols) are never requested and must not be preloaded, which is why these are
 * named one by one rather than globbed.
 *
 * Preloaded because the browser cannot otherwise know they exist until it has
 * fetched and parsed the stylesheet, which makes the critical path
 * HTML -> CSS -> font, three serial round trips on a phone. The preload starts
 * the font in parallel with the CSS. font-display: optional keeps text visible
 * and prevents a late swap from reflowing the page on a throttled connection.
 *
 * Imported with ?url rather than written out, because the filenames are
 * content-hashed and change whenever the font package is updated. A hardcoded
 * path would 404 silently after the next upgrade: a preload that misses costs a
 * wasted request and warns in the console, and nothing on the page looks wrong.
 */
import geistSans from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

const SITE = "AI Safety Tracker";

interface Props {
  /**
   * The page's own name, as it should read in a browser tab and a search result.
   *
   * Not the nav label: the nav array below holds its own short strings, because a
   * header row capped at 64px needs one word where a search result needs the
   * subject named. Where a page's H1 names the subject, this should be that H1.
   * The site name is appended here rather than written out per page, which is
   * what stopped three pages drifting into three different title formats.
   */
  title: string;
  description: string;
  /** source_ids cited anywhere on this page, rendered as the attribution block. */
  cites?: string[];
  /** Set on the homepage, where "AI Safety Tracker | AI Safety Tracker" is absurd. */
  root?: boolean;
  /**
   * Which section of the site this page belongs to, which sets its field hue.
   * Chrome only: the eyebrow, the rule above a section and the dot tint. See
   * the field hue block in global.css. Omit on a page that spans every section,
   * such as the homepage, which sets it per section instead.
   */
  field?: string;
  /**
   * Schema.org nodes for this page, emitted as one JSON-LD graph together with
   * the site-wide publisher node. Objects, never strings: the block is produced
   * by JSON.stringify, so a malformed block is not a thing that can happen.
   */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, cites = [], root = false, field, schema } = Astro.props;

/* Which nav item is the current page.
   "/" is a prefix of every path on the site, so the startsWith test that works
   for every other item would mark Home as the current page on all 33 of them.
   The root is the one entry that has to match exactly. */
const isCurrent = (href: string) =>
  href === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(href);
const documentTitle = root ? `${SITE}: cited data on AI capability, governance and safety` : `${title} | ${SITE}`;
const attributions = attributionsFor(...cites);
const canonical = new URL(Astro.url.pathname, Astro.site);

/* One card for the whole site, not one per page. A per-page card needs a
   rasteriser in the build; a single brand card needs a committed file and this
   line. It carries no figure on purpose: a number inside a PNG cannot be dated. */
const ogImage = new URL("/og.png", Astro.site);

/* JSON-LD. One graph per page: the publisher, the site node on the homepage, and
   whatever the page declares. Built from objects and stringified, so it cannot be
   invalid JSON. `<` is escaped because a "</script>" inside any string value would
   otherwise close this element early, which is the one way a data block can turn
   into markup. */
const origin = new URL("/", Astro.site).href;
const publisher = {
  "@type": "Organization",
  "@id": `${origin}#publisher`,
  name: SITE,
  url: origin,
  description: "An independent, cited index of AI capability, governance and safety.",
};
const website = {
  "@type": "WebSite",
  "@id": `${origin}#website`,
  name: SITE,
  url: origin,
  description,
  inLanguage: "en-GB",
  publisher: { "@id": `${origin}#publisher` },
};
const graph = [publisher, ...(root ? [website] : []), ...(schema ? [schema].flat() : [])];
const jsonld = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(
  /</g,
  "\\u003c",
);
const year = new Date().getFullYear();

/* Nav order runs outward from the models themselves: what they can do, what they
   cost, whether anyone can steer them, who uses them, where, under what law,
   what changed this week, and where every number came from. */
const nav = [
  { href: "/", label: "Home" },
  { href: "/progress/", label: "Progress" },
  { href: "/capability/", label: "Capability" },
  { href: "/alignment/", label: "Alignment" },
  { href: "/adoption/", label: "Adoption" },
  { href: "/map/", label: "Map" },
  { href: "/policy/", label: "Policy" },
  { href: "/news/", label: "News" },
  { href: "/sources/", label: "Sources" },
];
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" is:inline set:html={jsonld} />

    <link rel="preload" href={geistSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
    <link rel="mask-icon" href="/favicon.svg" color="#f2a950" />
    <!-- iOS ignores an SVG favicon and screenshots the page instead. Rasterised
         once from favicon.svg, which is geometry only, so the two cannot drift
         in shape; regenerate with sharp if the mark changes. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <!-- One card, brand only. The design lock's no-images rule governs what a
         page renders; this file renders on somebody else's platform and never
         here, so dist still carries zero img tags. Source and regeneration steps
         are in scripts/og-card.html. -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI Safety Tracker" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0e1829" />
    <meta name="color-scheme" content="dark" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body data-field={field}>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="head">
      <div class="wrap head__inner">
        <a href="/" class="brand">
          <span>AI Safety <span class="brand__accent">Tracker</span></span>
        </a>
        {/* Two renderings of one list. Exactly one is ever displayed: the row
            above 860px, the menu below it, each `display: none` at the other
            width and so absent from the accessibility tree rather than merely
            invisible. Duplicating eight links costs a few hundred bytes and
            avoids depending on overriding the UA's popover display rule, which
            is the only way to make a single element be both. */}
        <nav class="nav-row" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <button type="button" class="nav-button" popovertarget="site-menu" aria-label="Menu">
          <Icon name="ph:list" width="20" height="20" aria-hidden="true" />
        </button>

        <nav popover id="site-menu" class="nav-menu" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        {
          attributions.length > 0 && (
            <section class="attribution">
              <h2>Data sources on this page</h2>
              <ul>
                {attributions.map((source) => (
                  <li>
                    <a href={source.landing_page}>{source.name}</a>
                    <span class="attribution__pub">{source.publisher}</span>
                    <a href={source.licence_url} class="attribution__lic">
                      {source.licence}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="foot__end">
          <p>
            Figures are reproduced from the sources named above under their respective licences
            and remain theirs. Our own code, indexes and written explainers are
            <a href="https://opensource.org/licenses/MIT">MIT</a>. Errors are ours.
            <a href="/corrections/">Report one</a> and it gets fixed and listed rather than
            quietly patched.
          </p>
          <p class="foot__meta">
            <span>{year} AI Safety Tracker</span>
            <a href="/about/">About</a>
            <a href="/methodology/">Methodology</a>
            <a href="/glossary/">Glossary</a>
            <a href="/sources/">All sources</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/corrections/">Corrections</a>
          </p>
        </div>
      </div>
    </footer>

    <style>
      .head {
        position: sticky;
        inset-block-start: 0;
        z-index: 20;
        border-block-end: 1px solid var(--line);
        background: rgb(14 24 41 / 0.86);
        backdrop-filter: blur(12px);
      }

      /* Nav stays on one line and within the height cap. */
      .head__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        block-size: 64px;
      }

      /* The wordmark carries the site, so it is set at heading scale rather than
         at nav scale. "Tracker" takes the accent, which is the only place the
         accent is used as identity rather than as data. */
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--ink);
        font-weight: 600;
        font-size: clamp(1.125rem, 1rem + 0.5vw, 1.4375rem);
        letter-spacing: -0.025em;
        text-decoration: none;
        white-space: nowrap;
      }

      .brand__accent {
        color: var(--accent);
      }

      .nav-row ul {
        display: flex;
        gap: 1.05rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      /* Link styling is shared by both renderings. The popover sits in the top
         layer when open, which changes where it PAINTS and not where it sits in
         the tree, so a descendant selector still reaches it. */
      .head nav a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.8125rem;
        white-space: nowrap;
        transition: color 0.18s var(--ease);
      }

      .head nav a:hover,
      .head nav a[aria-current="page"] {
        color: var(--ink);
      }

      /* Above the breakpoint the menu does not exist: the button is display:none
         and therefore unfocusable, so the popover cannot be opened by pointer or
         by keyboard. The :popover-open rule is the one case left, a viewport
         widened while the menu happened to be open. */
      .nav-button,
      .nav-menu:popover-open {
        display: none;
      }

      /* 860px, not the 640px this used to be, and the number is measured rather
         than chosen. Nine non-wrapping links plus the wordmark plus the wrap
         padding need 804px of header at an 805px viewport, and the wordmark is
         clamp()ed on vw so the requirement grows with the viewport: the fixed
         point where the row first fits is 805px exactly. Below it the row
         overflowed the DOCUMENT rather than wrapping, because every link carries
         white-space: nowrap, which put all 35 pages 5px wider than an iPad in
         portrait and panned the whole site sideways there. 860 leaves headroom
         for a platform whose Geist rasterises a little wider than this one's. */
      @media (max-width: 860px) {
        /* One row again, the same height as the desktop header: brand at the
           start, one control at the end. The nav used to wrap to two rows of
           links here and stack the bar to 120px, which is what made a sticky
           header cost a fifth of a phone screen. The row height follows
           .head__inner, so it tracks the wordmark rather than a fixed number. */
        .nav-row {
          display: none;
        }

        .nav-button {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          /* 44px of touch target around a 20px glyph, per the WCAG minimum. */
          inline-size: 44px;
          block-size: 44px;
          margin-inline-end: -0.6rem;
          padding: 0;
          border: 0;
          border-radius: var(--r);
          background: none;
          color: var(--muted);
          cursor: pointer;
          transition: color 0.18s var(--ease), background-color 0.18s var(--ease);
        }

        .nav-button:hover,
        .nav-button:focus-visible {
          color: var(--ink);
          background: var(--surface-2);
        }

        /* Anchored to the viewport rather than to the button. A menu pinned
           under a sticky header has one correct place to be at every width, and
           position: fixed puts it there in every browser that ships popover;
           CSS anchor positioning does not yet have that reach. */
        .nav-menu:popover-open {
          display: block;
        }

        .nav-menu {
          position: fixed;
          inset: auto;
          inset-block-start: 52px;
          inset-inline-end: clamp(1rem, 3.5vw, 2.5rem);
          min-inline-size: 11rem;
          margin: 0.35rem 0 0;
          padding: 0.35rem;
          border: 1px solid var(--line);
          border-radius: var(--r);
          background: var(--surface-2);
          box-shadow: 0 16px 44px rgb(0 0 0 / 0.55);
        }

        .nav-menu ul {
          display: grid;
          gap: 0.05rem;
          margin: 0;
          padding: 0;
          list-style: none;
        }

        .nav-menu a {
          display: block;
          padding: 0.6rem 0.8rem;
          border-radius: var(--r);
          font-size: 0.875rem;
        }

        /* The row marks the current page; the colour is left to the shared
           `.head nav a[aria-current]` rule above, which is the same --ink the
           desktop nav uses. An --accent-ink rule here looked right and did
           nothing: `.head nav a[aria-current]` carries two element selectors to
           this one's one and wins on specificity regardless of order. */
        .nav-menu a:hover,
        .nav-menu a[aria-current="page"] {
          background: var(--surface);
        }
      }

      .foot {
        margin-block-start: 2rem;
        padding-block: 1.5rem 2rem;
        border-block-start: 1px solid var(--line);
        background: var(--bg-deep);
        font-size: 0.8125rem;
        color: var(--muted);
      }

      .attribution h2 {
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-block-end: 0.85rem;
      }

      .attribution ul {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
        gap: 0.2rem 2rem;
        margin: 0 0 1.25rem;
        padding: 0;
        list-style: none;
      }

      .attribution li {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding-block: 0.3rem;
        border-block-end: 1px solid var(--line-soft);
      }

      .attribution__pub {
        flex: 1;
        min-inline-size: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .attribution__lic {
        font-family: var(--f-mono);
        font-size: 0.6875rem;
        color: var(--muted);
        white-space: nowrap;
      }

      .foot__end p {
        max-inline-size: 68ch;
        line-height: 1.65;
      }

      .foot__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.1rem;
        margin-block-start: 0.9rem;
        padding-block-start: 0.9rem;
        border-block-start: 1px solid var(--line);
      }
    </style>
  </body>
</html>
